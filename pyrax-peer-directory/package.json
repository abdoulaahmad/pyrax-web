{
  "name": "pyrax-peer-directory",
  "version": "0.1.0",
  "private": true,
  "description": "PYRAX peer-presence directory service + website (peers.pyraxchain.com): real-time live peer lists per network, fed by a hardened, app-only announce API.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
