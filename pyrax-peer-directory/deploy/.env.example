# SPDX-License-Identifier: LicenseRef-PYRAX-Proprietary
#
# Copy to `.env` (git-ignored) and fill in, then `docker compose up -d --build`.

# The public domain Caddy serves + auto-fetches a TLS cert for.
DIRECTORY_DOMAIN=peers.pyraxchain.com

# Shared HMAC secret. The PYRAX apps (Inferno Node / Ember) sign their
# POST /api/announce with this; the server REJECTS every announce unless it
# shares the EXACT same value — so no peers appear until it matches the apps.
# Generate a strong one:   openssl rand -hex 32
PYRAX_DIRECTORY_SECRET=change-me-run-openssl-rand-hex-32

# Which networks this directory accepts announces for + lists in the dropdown
# (comma-separated). Internal-only deployments may trim this list.
PYRAX_ENABLED_NETWORKS=internal-devnet-simulated,devnet2,testnet,mainnet
