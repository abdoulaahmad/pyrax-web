# Reverse proxy + automatic HTTPS for all PYRAX websites on the websites droplet (64.227.8.153).
# Caddy provisions Let's Encrypt certs automatically the first time each domain resolves here —
# so you only need to point DNS at this droplet and it "just works".
{
	email info@pyraxnetwork.org
}

# --- marketing site (apex) + www redirect ---
pyraxnetwork.org {
	reverse_proxy website:80
}
www.pyraxnetwork.org {
	redir https://pyraxnetwork.org{uri} permanent
}

# --- nodes / status + run-a-node ---
# The marketing/run-a-node site, EXCEPT /__tunnel/* which is the tunnel relay's node
# registration endpoint (nodes dial wss://nodes.pyraxnetwork.org/__tunnel/register). Same
# host serves both: the relay path goes to the relay, everything else to the site.
nodes.pyraxnetwork.org {
	@tunnel path /__tunnel/*
	handle @tunnel {
		reverse_proxy tunnel-relay:8792
	}
	handle {
		reverse_proxy nodes-website:80
	}
}

# --- per-node portals: the self-hosted tunnel relay proxies each node's local portal.
# Wildcard ORIGIN cert via Cloudflare DNS-01 (HTTP-01 can't do wildcards); the edge cert
# is the zone's Advanced Certificate (Cloudflare-proxied). WebSockets pass through
# natively (browser portal WS + the node's outbound agent WS). ---
*.nodes.pyraxnetwork.org {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_TOKEN}
	}
	reverse_proxy tunnel-relay:8792
}

# --- block explorer: /api/* -> indexer, everything else -> static frontend ---
explorer.pyraxnetwork.org {
	@api path /api/*
	handle @api {
		reverse_proxy explorer-indexer:8788
	}
	handle {
		reverse_proxy explorer-web:80
	}
}

# --- peer directory: the zero-dep Node server serves both the UI and the /api + SSE stream ---
# (no `encode` here — SSE must stream unbuffered; the server sets its own headers.)
peers.pyraxnetwork.org {
	reverse_proxy peer-directory:8787
}

# --- team portal: the magic-link-gated Node server serves the SPA + the gated API ---
team.pyraxnetwork.org {
	reverse_proxy team-pyrax:8790
}

# --- on-chain events relayer (`pyrax relay`): HMAC-gated POST /event. team-pyrax
# reaches it internally (http://relay:8799); this public route is for health + future use. ---
relay.pyraxnetwork.org {
	reverse_proxy relay:8799
}

# --- public test-token faucet: a small web UI + rate-limited /drip endpoint.
# Dispenses test PYRX on the Pyrax Seed Network through the internal write node.
# SECURITY (finding M16): OVERWRITE X-Forwarded-For with the immediate client's IP
# ({remote_host}) rather than appending to a client-supplied value. Combined with the
# faucet's TRUST_PROXY=1 + rightmost-hop parsing, this makes the per-IP anti-automation
# caps (welcome + drip) see exactly one proxy-set, attacker-uncontrollable identity —
# closing the "rotate a spoofed leftmost XFF for a fresh bucket each request" bypass.
# This single-proxy topology (client -> Caddy -> faucet) is REQUIRED for the header to be
# trustworthy; do not chain another appending proxy in front without re-establishing it. ---
faucet.pyraxnetwork.org {
	reverse_proxy faucet:8800 {
		header_up X-Forwarded-For {remote_host}
	}
}

# --- update-notification feed: the static manifests (+ installers) the desktop apps
# and the CLI poll for "a new version is ready" banners (NOT OTA auto-install). Served
# from a host dir mounted into this container; each release drops its manifest under the
# matching path: cli/latest.json, node/latest*.yml, ember/latest*.yml, node-internal/.
# Version metadata is no-cache (always fresh); the immutable installer files cache long.
updates.pyraxnetwork.org {
	encode gzip
	root * /srv/updates
	@manifests path *latest*.json *latest*.yml
	header @manifests Cache-Control "no-cache"
	@installers path *.exe *.dmg *.AppImage *.zip *.tar.gz *.blockmap
	header @installers Cache-Control "public, max-age=2592000, immutable"
	file_server
}
