# Reverse proxy + automatic HTTPS for all PYRAX websites on the websites droplet (64.227.8.153).
# Caddy provisions Let's Encrypt certs automatically the first time each domain resolves here —
# so you only need to point DNS at this droplet and it "just works".
{
	email info@pyraxchain.com
}

# --- marketing site (apex) + www redirect ---
pyraxchain.com {
	reverse_proxy website:80
}
www.pyraxchain.com {
	redir https://pyraxchain.com{uri} permanent
}

# --- nodes / status + run-a-node ---
nodes.pyraxchain.com {
	reverse_proxy nodes-website:80
}

# --- block explorer: /api/* -> indexer, everything else -> static frontend ---
explorer.pyraxchain.com {
	@api path /api/*
	handle @api {
		reverse_proxy explorer-indexer:8788
	}
	handle {
		reverse_proxy explorer-web:80
	}
}

# --- peer directory: the zero-dep Node server serves both the UI and the /api + SSE stream ---
# (no `encode` here — SSE must stream unbuffered; the server sets its own headers.)
peers.pyraxchain.com {
	reverse_proxy peer-directory:8787
}

# --- team portal: the magic-link-gated Node server serves the SPA + the gated API ---
team-pyrax.pyraxchain.com {
	reverse_proxy team-pyrax:8790
}

# --- on-chain events relayer (`pyrax relay`): HMAC-gated POST /event. team-pyrax
# reaches it internally (http://relay:8799); this public route is for health + future use. ---
relay.pyraxchain.com {
	reverse_proxy relay:8799
}

# --- public test-token faucet: a small web UI + rate-limited /drip endpoint.
# Dispenses test PYRX on Internal Devnet 1.0 through the internal write node. ---
faucet.pyraxchain.com {
	reverse_proxy faucet:8800
}

# --- update-notification feed: the static manifests (+ installers) the desktop apps
# and the CLI poll for "a new version is ready" banners (NOT OTA auto-install). Served
# from a host dir mounted into this container; each release drops its manifest under the
# matching path: cli/latest.json, node/latest*.yml, ember/latest*.yml, node-internal/.
# Version metadata is no-cache (always fresh); the immutable installer files cache long.
updates.pyraxchain.com {
	encode gzip
	root * /srv/updates
	@manifests path *latest*.json *latest*.yml
	header @manifests Cache-Control "no-cache"
	@installers path *.exe *.dmg *.AppImage *.zip *.tar.gz *.blockmap
	header @installers Cache-Control "public, max-age=2592000, immutable"
	file_server
}
