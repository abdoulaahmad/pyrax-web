# SPDX-License-Identifier: LicenseRef-PYRAX-Proprietary
# Copy to `.env` on the droplet ONLY (chmod 600). NEVER commit the real .env.
#
# Shared HMAC secret for the peer-directory announce API. Must EXACTLY match the
# PYRAX_DIRECTORY_SECRET the desktop apps (Ember / Inferno Node) sign announces with.
# Generate a strong one:  openssl rand -hex 32
PYRAX_DIRECTORY_SECRET=

# Optional image tag override (defaults to "latest"). CI also deploys "latest".
# TAG=latest
