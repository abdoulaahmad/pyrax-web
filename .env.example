# SPDX-License-Identifier: LicenseRef-PYRAX-Proprietary
# Copy to `.env` on the droplet ONLY (chmod 600). NEVER commit the real .env.
#
# Shared HMAC secret for the peer-directory announce API. Must EXACTLY match the
# PYRAX_DIRECTORY_SECRET the desktop apps (Ember / Inferno Node) sign announces with.
# Generate a strong one:  openssl rand -hex 32
PYRAX_DIRECTORY_SECRET=

# Optional image tag override (defaults to "latest"). CI also deploys "latest".
# TAG=latest

# --- NOVA observability + remediation (see README "NOVA observability + remediation") ---
# Shared bearer token the nova-agent uses to ship EVERY container's logs to NOVA
# (status.pyraxchain.com). Required for shipping; must match NOVA's configured value.
# Generate a strong one:  openssl rand -hex 32
NOVA_AGENT_SECRET=

# Set to 1 to let NOVA auto-restart STATELESS containers on this droplet via its
# approved-action queue. Chain-affecting restarts stay advisory + 15-min-warned.
NOVA_AGENT_REMEDIATION=0
