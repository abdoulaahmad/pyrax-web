{
  "name": "pyrax-devnet-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PYRAX Devnet Tester Portal — closed-alpha testing hub (devnet.pyraxchain.com): node uptime, Issue Council, rewards, leaderboard, realtime chat.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host --port 4322",
    "build": "astro build",
    "preview": "astro preview --host --port 4322",
    "check": "astro check",
    "test": "vitest run",
    "redteam": "vitest run --config redteam/vitest.redteam.config.ts",
    "redteam:watch": "vitest --config redteam/vitest.redteam.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "@types/pg": "^8.20.0",
    "astro": "^7.0.9",
    "framer-motion": "^11.18.2",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.13",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
