# SPDX-License-Identifier: LicenseRef-Proprietary
#
# PYRAX Devnet Tester Portal — environment template. Copy to .env (gitignored) and fill in real
# values for local development; in production these are injected by pyrax-infra (NOT this file).
# NEVER commit real secrets. Placeholders below are safe, non-functional examples.

# ---- Runtime ----------------------------------------------------------------------------------
# Set to "production" on the server. Enables HSTS/CSP and the fail-closed secret guards (a missing
# SESSION_SECRET / DEVNET_CHAT_SECRET will refuse to boot in production).
NODE_ENV=development

# ---- Database (DigitalOcean Managed Postgres) -------------------------------------------------
# Primary connection string for the `devnet_tester` database. If unset, the app falls back to
# DATABASE_URL / DATABASE_URL_TEAM_PYRAX with the db name swapped to devnet_tester.
DATABASE_URL_DEVNET=postgres://USER:PASSWORD@db-host.ondigitalocean.com:25060/devnet_tester
# Optional fallbacks (only used if DATABASE_URL_DEVNET is unset):
# DATABASE_URL=postgres://USER:PASSWORD@db-host:25060/defaultdb
# DATABASE_URL_TEAM_PYRAX=postgres://USER:PASSWORD@db-host:25060/team_pyrax

# ---- Sessions / auth --------------------------------------------------------------------------
# REQUIRED in production. Keyed HMAC for OTP codes + session ids (32+ random bytes recommended).
SESSION_SECRET=change-me-to-a-long-random-string
# The hardcoded superuser (full access, exempt from the legal gate). Defaults to shawn.wilson@pyraxchain.com.
SUPERUSER_EMAIL=shawn.wilson@pyraxchain.com

# ---- Shared chat (devnet portal + team site + standalone WS server) ---------------------------
# REQUIRED in production. HMAC secret that signs/verifies the short-lived chat tokens. MUST match the
# value used by scripts/chat-server.mjs and the team site. The dev default "dev-chat-secret-change-me"
# is rejected in production.
DEVNET_CHAT_SECRET=change-me-to-a-long-random-string
# Browser-facing WebSocket URL of the chat server (added to the CSP connect-src in production).
CHAT_WS_URL=ws://localhost:8788
# Port the standalone chat WS server (scripts/chat-server.mjs) listens on (and exposes GET /health).
CHAT_WS_PORT=8788

# ---- Email (Brevo) ----------------------------------------------------------------------------
# Transactional email: sign-in codes, invites, release alerts, Issue Council notifications.
BREVO_API_KEY=
BREVO_SENDER=no-reply@pyraxchain.com
BREVO_DEVNET_SENDER_NAME=PYRAX Devnet
# Optional Brevo stored-template ids (0 / unset => inline HTML fallback is used):
BREVO_DEVNET_OTP_TEMPLATE_ID=0
BREVO_DEVNET_INVITE_TEMPLATE_ID=0
BREVO_DEVNET_RELEASE_TEMPLATE_ID=0
BREVO_DEVNET_NOTIFY_TEMPLATE_ID=0

# ---- Public URL -------------------------------------------------------------------------------
# Base URL used to build links in emails. Defaults to https://devnet.pyraxchain.com.
PUBLIC_URL=http://localhost:4322

# ---- Web Push (VAPID) -------------------------------------------------------------------------
# Browser push for release alerts. Inert if the keys are unset. Generate with `web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@pyraxchain.com

# ---- Object storage (DigitalOcean Spaces) -----------------------------------------------------
# Direct-to-Spaces presigned uploads for Issue Council attachments AND presigned downloads of the
# private release feeds (Inferno `node/` + CLI `cli/`) surfaced on the Downloads page. If unset,
# uploads degrade to text-only and the Downloads page honestly reports "no build available yet".
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=tor1
SPACES_BUCKET=pyrax
# Optional: override the Spaces origin (e.g. "https://tor1.digitaloceanspaces.com"). When unset it is
# derived from SPACES_REGION + SPACES_BUCKET (virtual-hosted style). NEVER print/commit real values.
SPACES_ENDPOINT=

# ---- GIFs (Giphy) -----------------------------------------------------------------------------
# Optional. Enables the GIF picker in chat; if unset, the GIF button shows a "not configured" note.
GIPHY_API_KEY=
