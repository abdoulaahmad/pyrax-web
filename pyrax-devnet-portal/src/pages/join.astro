---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Base from "../layouts/Base.astro";
import Join from "../components/Join.tsx";
import { inviteByToken } from "../server/db";
export const prerender = false;

const token = Astro.url.searchParams.get("token") || "";
let email = "", telegram = "", error = "";
if (!token) {
  error = "Missing invite link.";
} else {
  const inv = await inviteByToken(token);
  if (!inv) error = "This invite link is invalid.";
  else if (inv.accepted_at) error = "This invite has already been used — sign in instead.";
  else if (Number(inv.expires_at) <= Date.now()) error = "This invite has expired.";
  else { email = inv.email; telegram = inv.telegram_handle; }
}
---
<Base title="Join the Devnet">
  <Join token={token} email={email} telegram={telegram} error={error} client:load />
</Base>
