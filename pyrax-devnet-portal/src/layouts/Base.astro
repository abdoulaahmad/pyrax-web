---
// SPDX-License-Identifier: LicenseRef-Proprietary
import "../styles/global.css";
import CookieConsent from "../components/CookieConsent.tsx";
// Brand title rule: every page title starts with "PYRAX™". (Standard for all PYRAX sites.)
const { title = "Devnet Tester Portal" } = Astro.props;
const fullTitle = /^PYRAX/.test(title) ? title : `PYRAX™ · ${title}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050609" />
    <!-- Self-hosted fonts (see styles/fonts.css) — no third-party origin, keeps the CSP tight. -->
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-latin.woff2" as="font" type="font/woff2" crossorigin />
    <noscript><style>[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    <slot />
    <CookieConsent client:idle />
    <script is:inline>
      // Progressive scroll-reveal — mirrors the marketing site so both surfaces animate identically.
      // No-JS / observer failure shows everything (see the [data-reveal] noscript rule in <head>).
      (() => {
        const arm = () => {
          const els = document.querySelectorAll("[data-reveal]:not(.revealed)");
          if (!("IntersectionObserver" in window)) { els.forEach((e) => e.classList.add("revealed")); return; }
          const io = new IntersectionObserver((entries) => {
            for (const en of entries) {
              if (en.isIntersecting) { en.target.classList.add("revealed"); io.unobserve(en.target); }
            }
          }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
          els.forEach((e) => {
            const r = e.getBoundingClientRect();
            if (r.top < window.innerHeight * 0.92) e.classList.add("revealed"); // already in view on load
            else io.observe(e);
          });
        };
        if (document.readyState !== "loading") arm(); else document.addEventListener("DOMContentLoaded", arm);
      })();
    </script>
  </body>
</html>
