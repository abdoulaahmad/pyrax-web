# Holding/security.txt origin for pyraxchain.com, served from behind the Cloudflare proxy.
# Cloudflare terminates the public TLS (visitors see Cloudflare's cert); the zone SSL mode is
# "Full", so Cloudflare connects to this origin over HTTPS and accepts ANY origin cert. We use
# Caddy's internal self-signed cert (`tls internal`) — no Let's Encrypt round-trip is needed or
# possible cleanly behind the orange-cloud proxy. Hosts are named so the internal cert is
# provisioned at startup (a host-less :443 block can't issue for an arbitrary SNI).

{
	auto_https disable_redirects
	admin off
}

# HTTPS origin (Cloudflare "Full" connects here with SNI=pyraxchain.com).
pyraxchain.com, www.pyraxchain.com {
	tls internal
	root * /srv
	file_server
	header /.well-known/security.txt Content-Type "text/plain; charset=utf-8"
	encode gzip
}

# Plain HTTP origin (Cloudflare may also connect on :80; no ACME).
http://pyraxchain.com, http://www.pyraxchain.com {
	root * /srv
	file_server
	header /.well-known/security.txt Content-Type "text/plain; charset=utf-8"
	encode gzip
}
