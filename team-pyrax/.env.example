# SPDX-License-Identifier: LicenseRef-PYRAX-Proprietary
# team-pyrax configuration. Copy to .env for local dev; in production these are
# injected by the deploy workflow (secrets) / set in docker-compose (non-secrets).
# NEVER commit real secrets.

# --- public origin (builds magic-link URLs, locks CORS/CSRF, sets Secure cookies) ---
PUBLIC_URL=https://team-pyrax.pyraxchain.com

# --- database: DigitalOcean Managed PostgreSQL (SECRET = the full URL) ---
# Production = the cluster's VPC (private) connection string. Local dev defaults to a
# throwaway local Postgres if unset (see README): postgres://postgres:dev@localhost:5544/team_pyrax
DATABASE_URL=
# Optional: PEM of DO's CA cert to fully verify the DB server cert (else encrypted-only).
DATABASE_CA=

# --- auth (SECRET) ---
# Pepper for hashing tokens/sessions + deriving CSRF. Generate: openssl rand -hex 32
# If unset, an ephemeral per-boot key is used (sessions reset on restart).
SESSION_SECRET=

# --- transactional email: Brevo (SECRET = the API key) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@pyraxchain.com
BREVO_SENDER_NAME=PYRAX Team

# --- downloads: DigitalOcean Spaces OTA feed ---
# Public base used to resolve "newest version" metadata (latest*.yml / manifest.json).
OTA_BASE=https://updates.pyraxchain.com
# DOWNLOAD_MODE: presign (short-lived signed Spaces URLs — gated) | public (redirect to OTA CDN).
# Defaults to presign when the Spaces creds below are set, else public.
DOWNLOAD_MODE=
# DO Spaces (SECRET = key/secret) — only needed for DOWNLOAD_MODE=presign.
SPACES_REGION=nyc3
SPACES_BUCKET=pyrax-updates
SPACES_KEY=
SPACES_SECRET=
# SPACES_ENDPOINT=nyc3.digitaloceanspaces.com   # optional; derived from region if unset
# PRESIGN_TTL_S=120

# --- identity (defaults are correct; override only for testing) ---
# TEAM_EMAIL_DOMAIN=pyraxchain.com
# TEAM_SUPERUSER=shawn.wilson@pyraxchain.com

# --- runtime ---
PORT=8790
TRUST_PROXY=1
