{
  "name": "team-pyrax",
  "version": "0.1.0",
  "private": true,
  "description": "PYRAX Team portal (team-pyrax.pyraxchain.com): a magic-link-gated, role-based internal hub. v1 module = the versioned download center for the Ember, Inferno and CLI installers; User Management whitelists @pyraxchain.com teammates.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js",
    "serve": "pnpm build && node server/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "better-sqlite3"
    ]
  }
}
