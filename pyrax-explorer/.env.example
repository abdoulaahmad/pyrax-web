# --- Frontend (Vite, build/dev time) ---
# The indexer base the browser calls. Leave UNSET for the normal behavior:
#   • localhost dev  -> http://localhost:8788
#   • production      -> "" (same origin; Caddy proxies /api/* to the indexer)
# Only set this to point the frontend at a non-default indexer.
# VITE_INDEXER_BASE=

# --- Indexer (server/, runtime) ---
PORT=8788
HOST=0.0.0.0
DATA_DIR=./data
ALLOW_ORIGIN=*
INGEST_INTERVAL_MS=4000
INGEST_BATCH=40
# Per-network RPC endpoints to ingest (only wired networks are indexed):
RPC_881109=https://sidn-rpc.pyraxchain.com:8811
# RPC_710823=
# RPC_104928=
# RPC_563821=
