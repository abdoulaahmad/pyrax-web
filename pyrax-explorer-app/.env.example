# SPDX-License-Identifier: LicenseRef-Proprietary
#
# PYRAX Explorer — environment template. Copy to `.env` and fill in. EVERYTHING here is OPTIONAL:
# the SSR app is fail-safe and renders with PYRAX-native SAMPLE data when no RPC/DB is configured
# (data-layer precedence: indexer → live RPC → sample). Set what you have; leave the rest blank.
#
# Two processes read these:
#   • the SSR explorer app  (astro + @astrojs/node)   — src/server/*
#   • the standalone indexer (node 24, pg + solc + ws) — indexer/*
# They share the same DB + RPC variables so they stay in sync.

# ─────────────────────────────────────────────────────────────────────────────
# Per-network JSON-RPC endpoints (chain id → URL). Only networks with a non-empty
# RPC are reachable/indexed; the rest render as "not live yet" / fall back to sample.
# Chain ids mirror src/lib/networks.ts and indexer/config.js.
# ─────────────────────────────────────────────────────────────────────────────
RPC_881109=https://pyrax-seed.rpc.pyraxchain.com    # Pyrax Seed (internal simulated devnet)
RPC_710823=https://pyrax-forge.rpc.pyraxchain.com   # Pyrax Forge (closed-alpha devnet)
RPC_104928=                                          # Pyrax Rise (public testnet — launching soon)
RPC_563821=                                          # Pyrax One (mainnet — after the audit gate)

# ─────────────────────────────────────────────────────────────────────────────
# Database (DigitalOcean Managed PostgreSQL). When UNSET, the app skips the indexer
# entirely and serves live-RPC → sample. EXPLORER_DATABASE_URL is preferred so the
# explorer's DB is distinct from other site DBs on the same cluster; DATABASE_URL is
# accepted as a fallback by both the app and the indexer.
# ─────────────────────────────────────────────────────────────────────────────
EXPLORER_DATABASE_URL=postgres://USER:PASSWORD@HOST:25060/pyrax_explorer?sslmode=require
DATABASE_URL=                                        # fallback if EXPLORER_DATABASE_URL is unset
DATABASE_SSL=                                         # "1" to force TLS when the URL has no sslmode=require
DATABASE_CA=                                          # optional PEM (verifies the DB server cert chain)
EXPLORER_PG_POOL_MAX=4                                # SSR app pg pool size
PG_POOL_MAX=10                                        # indexer pg pool size

# ─────────────────────────────────────────────────────────────────────────────
# HTTP listen — app defaults to 4324, indexer to 8788.
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4324                                             # indexer Dockerfile overrides to 8788

# ─────────────────────────────────────────────────────────────────────────────
# Indexer ingest cadence + bounds (kept modest so a public node isn't hammered).
# ─────────────────────────────────────────────────────────────────────────────
INGEST_INTERVAL_MS=4000                               # ms between ingest ticks
INGEST_BATCH=40                                       # max blocks ingested per network per tick
RECEIPT_CONCURRENCY=8                                 # parallel receipt fetches during ingest

# ─────────────────────────────────────────────────────────────────────────────
# Indexer read-API CORS. "*" is fine for a public read-only API.
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
# Contract-verification remote-compile throttle (indexer/verify.js). Bounds CPU +
# outbound solc downloads so a flood of distinct version tags can't exhaust the box.
# ─────────────────────────────────────────────────────────────────────────────
VERIFY_MAX_CONCURRENT=2                               # simultaneous solc compiles
VERIFY_QUEUE_WAIT_MS=20000                            # max ms a request waits for a compile slot
VERIFY_COMPILER_TTL_MS=600000                         # cached solc compiler TTL
VERIFY_COMPILER_CACHE_MAX=6                           # max distinct cached solc versions
