---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getBlocks } from "../server/chain";
import LiveBlocks from "../components/LiveBlocks.tsx";
const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const before = Number(Astro.url.searchParams.get("before")) || undefined;
// SSR seed for the island (client:load server-renders it), then it polls /api/blocks every ~5s to keep
// the table live without a full page reload. The ?before= cursor is passed through so a paged view keeps
// polling its own window.
const { source, blocks } = await getBlocks(net, before);
---
<Shell title="Blocks">
  <LiveBlocks client:load initial={blocks} initialSource={source} before={before} />
</Shell>
