---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getBlocks } from "../server/chain";
import { SEAL_LABEL } from "../server/sample";
import { shortAddr, fmtNum, timeAgo, STREAM_TONE } from "../lib/format";
const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const before = Number(Astro.url.searchParams.get("before")) || undefined;
const { source, blocks } = await getBlocks(net, before);
const oldest = blocks.length ? blocks[blocks.length - 1].number : 0;
---
<Shell title="Blocks">
  <div class="flex items-center gap-2">
    <h1 class="text-2xl font-extrabold sm:text-3xl">Blocks</h1>
    {source === "sample" && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <p class="mt-1 text-sm text-muted">Each block carries its GhostDAG blue score, emission stream (A/B/C) and the seal lane that produced it.</p>

  <div class="card mt-5 overflow-hidden p-0">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-line text-left text-xs uppercase tracking-wider text-faint">
          <th class="px-4 py-3 font-semibold">Block</th><th class="px-4 py-3 font-semibold">Age</th><th class="px-4 py-3 font-semibold">Stream</th><th class="px-4 py-3 font-semibold">Seal</th><th class="px-4 py-3 font-semibold">Txns</th><th class="px-4 py-3 font-semibold">Producer</th><th class="px-4 py-3 text-right font-semibold">Gas used</th>
        </tr></thead>
        <tbody>
          {blocks.map((b: any) => (
            <tr class="border-b border-line-soft last:border-0 hover:bg-[rgba(255,255,255,0.02)]">
              <td class="px-4 py-3"><a href={`/block/${b.number}`} class="font-mono font-semibold text-[color:var(--color-brand)]">#{fmtNum(b.number)}</a></td>
              <td class="px-4 py-3 text-muted">{timeAgo(b.timestamp)}</td>
              <td class="px-4 py-3"><span class="rounded-md px-1.5 py-0.5 text-[0.62rem] font-bold" style={`color:${STREAM_TONE[b.stream]};background:${STREAM_TONE[b.stream]}1a`}>{b.stream}</span></td>
              <td class="px-4 py-3 text-xs text-muted">{SEAL_LABEL[b.sealAlgo] || b.sealAlgo}</td>
              <td class="px-4 py-3 text-muted">{b.txCount}</td>
              <td class="px-4 py-3"><a href={`/address/${b.miner}`} class="font-mono text-xs text-muted hover:text-ink">{shortAddr(b.miner)}</a></td>
              <td class="px-4 py-3 text-right font-mono text-xs text-muted">{fmtNum(b.gasUsed)} <span class="text-faint">/ {fmtNum(b.gasLimit)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="mt-4 flex justify-end"><a href={`/blocks?before=${oldest - 1}`} class="btn btn-ghost">Older blocks →</a></div>
</Shell>
