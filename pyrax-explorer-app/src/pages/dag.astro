---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getDag } from "../server/chain";
import { SEAL_LABEL, STREAM_LABEL } from "../server/sample";
import { shortHash, fmtNum, timeAgo, STREAM_TONE } from "../lib/format";

const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const d: any = await getDag(net);
const sample = d.source === "sample";
const nodes = d.nodes as any[];

// Layout: newest (index 0) on the LEFT, time flows right toward older parents.
const LANE: Record<string, number> = { A: 64, B: 150, C: 236 };
const COL = 52, PAD = 34, R = 10, H = 300;
const W = PAD * 2 + Math.max(1, nodes.length - 1) * COL;
const pos = (i: number) => ({ x: PAD + i * COL, y: LANE[nodes[i].stream] + (i % 2 ? 14 : -14) });
const edges: { x1: number; y1: number; x2: number; y2: number; sel: boolean }[] = [];
nodes.forEach((n, i) => (n.parents || []).forEach((p: number, pi: number) => {
  if (p >= 0 && p < nodes.length) { const a = pos(i), b = pos(p); edges.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, sel: pi === 0 }); }
}));
const streamTotal = Math.max(1, d.streamCounts.A + d.streamCounts.B + d.streamCounts.C);
const SEAL_TONE: Record<string, string> = { blake3: "#f58622", sha256d: "#f5a623", kheavyhash: "#60b8cc", argon2id: "#3981c0", pos: "#34d399" };
---
<Shell title="DAG & Streams" description="The PYRAX GhostDAG — multi-parent blocks across three emission streams and five seal lanes.">
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-extrabold sm:text-3xl">DAG &amp; Streams</h1>
    {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <p class="mt-1 max-w-2xl text-sm text-muted">GhostDAG orders blocks by <span class="text-ink">blue score</span> across a multi-parent graph. Each block is sealed in one of three streams — <span style="color:#f58622">A</span> (BLAKE3 / SHA-256d, ASIC), <span style="color:#60b8cc">B</span> (kHeavyHash / Argon2id, GPU·CPU) and <span style="color:#34d399">C</span> (PoS / BLS finality).</p>

  <!-- stream distribution -->
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    {(["A", "B", "C"] as const).map((s) => (
      <div class="card p-4">
        <div class="flex items-center justify-between"><span class="flex items-center gap-2 text-sm font-semibold"><span class="h-2.5 w-2.5 rounded-full" style={`background:${STREAM_TONE[s]};box-shadow:0 0 8px ${STREAM_TONE[s]}`}></span>{STREAM_LABEL[s]}</span><span class="font-mono text-lg font-extrabold" style={`color:${STREAM_TONE[s]}`}>{d.streamCounts[s]}</span></div>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[rgba(255,255,255,0.05)]"><div class="h-full rounded-full" style={`width:${Math.round((d.streamCounts[s] / streamTotal) * 100)}%;background:${STREAM_TONE[s]}`}></div></div>
      </div>
    ))}
  </div>

  <!-- DAG graph -->
  <div class="card mt-5 overflow-hidden p-0">
    <div class="flex items-center justify-between border-b border-line px-5 py-3">
      <h3 class="text-base font-bold">GhostDAG · recent window</h3>
      <div class="hidden items-center gap-3 text-[0.7rem] text-faint sm:flex">
        <span class="flex items-center gap-1"><span class="inline-block h-0.5 w-4" style="background:var(--color-brand)"></span> selected parent</span>
        <span class="flex items-center gap-1"><span class="inline-block h-0.5 w-4 bg-[color:var(--color-line)]"></span> merge parent</span>
      </div>
    </div>
    <div class="overflow-x-auto p-4">
      <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} class="block" style="min-width:100%">
        <!-- lane guides -->
        {(["A", "B", "C"] as const).map((s) => (
          <g>
            <line x1="0" y1={LANE[s]} x2={W} y2={LANE[s]} stroke="rgba(255,255,255,0.04)" stroke-width="1" />
            <text x="6" y={LANE[s] - 20} fill={STREAM_TONE[s]} font-size="11" font-weight="700" opacity="0.7">Stream {s}</text>
          </g>
        ))}
        <!-- edges -->
        {edges.map((e) => (
          <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.sel ? "rgba(245,134,34,0.55)" : "rgba(120,130,150,0.28)"} stroke-width={e.sel ? 1.6 : 1} />
        ))}
        <!-- nodes -->
        {nodes.map((n, i) => { const p = pos(i); return (
          <a href={`/block/${n.blueScore}`}>
            <circle cx={p.x} cy={p.y} r={R} fill={`${STREAM_TONE[n.stream]}22`} stroke={STREAM_TONE[n.stream]} stroke-width="1.8" />
            <circle cx={p.x} cy={p.y} r="3.2" fill={SEAL_TONE[n.sealAlgo] || STREAM_TONE[n.stream]} />
            {i % 3 === 0 && <text x={p.x} y={p.y + (i % 2 ? 26 : -18)} fill="var(--color-faint)" font-size="9" text-anchor="middle" font-family="monospace">{fmtNum(n.blueScore)}</text>}
          </a>
        ); })}
      </svg>
    </div>
  </div>

  <!-- seal-lane legend + recent list -->
  <div class="mt-5 grid gap-5 lg:grid-cols-3">
    <div class="card p-5">
      <h3 class="text-base font-bold">Seal lanes</h3>
      <p class="text-xs text-muted">Five proof lanes across the three streams.</p>
      <div class="mt-3 space-y-2 text-sm">
        {Object.entries(SEAL_LABEL).map(([k, label]) => (
          <div class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full" style={`background:${SEAL_TONE[k]}`}></span><span class="text-ink">{label}</span></div>
        ))}
      </div>
    </div>
    <div class="card overflow-hidden p-0 lg:col-span-2">
      <div class="border-b border-line px-5 py-3"><h3 class="text-base font-bold">Recent DAG blocks</h3></div>
      <div class="max-h-[18rem] divide-y divide-[color:var(--color-line-soft)] overflow-y-auto">
        {nodes.slice(0, 14).map((n) => (
          <a href={`/block/${n.blueScore}`} class="flex items-center justify-between gap-3 px-5 py-2.5 hover:bg-[rgba(255,255,255,0.02)]">
            <div class="flex items-center gap-2.5">
              <span class="grid h-7 w-7 place-items-center rounded-md text-[0.6rem] font-bold" style={`color:${STREAM_TONE[n.stream]};background:${STREAM_TONE[n.stream]}1a`}>{n.stream}</span>
              <div><code class="font-mono text-sm text-ink">{shortHash(n.hash)}</code><div class="text-[0.7rem] text-faint">blue score {fmtNum(n.blueScore)} · {n.parents.length} parent{n.parents.length === 1 ? "" : "s"}</div></div>
            </div>
            <div class="text-right text-xs"><div class="text-muted">{SEAL_LABEL[n.sealAlgo]}</div><div class="text-faint">{timeAgo(n.timestamp)}</div></div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Shell>
