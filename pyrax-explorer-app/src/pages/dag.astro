import Shell from "../layouts/Shell.astro";
---
<Shell title="DAG & Streams">
  <h1 class="text-2xl font-extrabold sm:text-3xl">DAG & Streams</h1>
  <p class="mt-1 max-w-2xl text-muted">The GhostDAG block graph — parents, blue score, and the three emission streams across five seal lanes.</p>
  <div class="card mt-6 p-8">
    <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-brand)]"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3c1 3 4 4 4 8a4 4 0 0 1-8 0c0-1.5.6-2.3 1.2-3C9.8 9 10 7 9 5c2 .5 3 1.5 3 3 0-1.7 0-3.5 0-5Z"/></svg> In active development</div>
    <p class="mt-1.5 max-w-xl text-sm text-muted">An interactive DAG view from pyrax_dagRecent showing the multi-parent structure, stream A/B/C grouping and seal-algo lanes.</p>
  </div>
</Shell>
