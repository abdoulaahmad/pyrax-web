---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import RpcConsole from "../components/RpcConsole.tsx";
import { selectedChainId, netFor } from "../server/chain";
const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
---
<Shell title="RPC Playground" description="A guided JSON-RPC console for the PYRAX eth_* and native pyrax_* method namespaces.">
  <h1 class="text-2xl font-extrabold sm:text-3xl">RPC Playground</h1>
  <p class="mt-1 max-w-2xl text-sm text-muted">Call read-only <span class="text-ink">eth_*</span> and native <span class="text-ink">pyrax_*</span> methods against <span class="text-ink">{net.name}</span>. Requests are proxied server-side, so state-changing and privileged methods are unavailable here by design.</p>
  <div class="mt-5">
    <RpcConsole client:load />
  </div>
</Shell>
