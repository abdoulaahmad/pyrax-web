import Shell from "../layouts/Shell.astro";
---
<Shell title="RPC Playground">
  <h1 class="text-2xl font-extrabold sm:text-3xl">RPC Playground</h1>
  <p class="mt-1 max-w-2xl text-muted">Call any eth_* or pyrax_* method against the selected network, right here.</p>
  <div class="card mt-6 p-8">
    <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-brand)]"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3c1 3 4 4 4 8a4 4 0 0 1-8 0c0-1.5.6-2.3 1.2-3C9.8 9 10 7 9 5c2 .5 3 1.5 3 3 0-1.7 0-3.5 0-5Z"/></svg> In active development</div>
    <p class="mt-1.5 max-w-xl text-sm text-muted">A guided JSON-RPC console covering the full eth_* set plus the native pyrax_* namespace (DAG, shielded, consensus).</p>
  </div>
</Shell>
