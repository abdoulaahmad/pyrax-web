---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getNetwork } from "../server/chain";
import { SEAL_LABEL } from "../server/sample";
import { shortHash, shortAddr, fmtNum } from "../lib/format";

const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const n: any = await getNetwork(net);
const sample = n.source === "sample";
const syncPct = n.target > 0 ? Math.min(100, Math.round((n.height / n.target) * 100)) : 100;
const laneTotal = Math.max(1, Object.values(n.sealLanes).reduce((a: number, b: any) => a + Number(b), 0));
const SEAL_TONE: Record<string, string> = { blake3: "#f58622", sha256d: "#f5a623", kheavyhash: "#60b8cc", argon2id: "#3981c0", pos: "#34d399" };
const tiles = [
  { label: "Consensus mode", value: n.mode, sub: n.modeNote || `${(n.activeStreams || []).join(" · ") || "—"} active` },
  { label: "Block height", value: "#" + fmtNum(n.height), sub: n.targetKnown ? "network height known" : "verifying height…" },
  { label: "Finalized", value: "#" + fmtNum(n.finalizedHeight), sub: "Stream C · BFT" },
  { label: "Peers", value: fmtNum(n.peerCount), sub: n.incompatiblePeers ? `${n.incompatiblePeers} incompatible` : "all compatible" },
];
---
<Shell title="Network" description="PYRAX network health — consensus mode, finality, peers and the per-seal-lane production mix.">
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-extrabold sm:text-3xl">Network</h1>
    <span class="chip" style={n.syncing ? "color:var(--color-warning);border-color:rgba(245,166,35,.4)" : "color:var(--color-positive);border-color:rgba(52,211,153,.4)"}>{n.syncing ? "syncing" : "in sync"}</span>
    {n.updateRequired && <span class="chip" style="color:var(--color-negative);border-color:rgba(251,111,115,.4)">update required</span>}
    {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <p class="mt-1 text-sm text-muted">{net.name} · chain {n.chainId || net.chainId} · {n.clientVersion}</p>

  <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {tiles.map((t) => (
      <div class="card p-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-faint">{t.label}</div>
        <div class="mt-1.5 text-2xl font-extrabold capitalize">{t.value}</div>
        <div class="mt-0.5 text-xs text-faint">{t.sub}</div>
      </div>
    ))}
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <!-- sync -->
    <div class="card p-5">
      <h3 class="text-base font-bold">Sync status</h3>
      <div class="mt-3 flex items-end justify-between"><span class="text-sm text-muted">height / target</span><span class="font-mono text-sm text-ink">{fmtNum(n.height)} / {fmtNum(n.target)}</span></div>
      <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-[rgba(255,255,255,0.05)]"><div class="h-full flame-bar" style={`width:${syncPct}%`}></div></div>
      <div class="mt-1 text-right text-xs text-faint">{syncPct}%</div>
      <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
        <div><dt class="text-xs text-faint">Target known</dt><dd class="mt-0.5">{n.targetKnown ? "yes" : "verifying…"}</dd></div>
        <div><dt class="text-xs text-faint">Incompatible peers</dt><dd class="mt-0.5">{n.incompatiblePeers}</dd></div>
      </dl>
    </div>

    <!-- seal-lane mix -->
    <div class="card p-5">
      <div class="flex items-center gap-2">
        <h3 class="text-base font-bold">Seal-lane production</h3>
        {n.sealLanesDerived && <span class="chip chip-muted" title="seal_algo isn't surfaced by RPC — the lane is reconstructed from each block's (real) stream, not read from the header">derived</span>}
      </div>
      <p class="text-xs text-muted">Recent blocks by proof lane across the three streams.{n.sealLanesDerived ? " Lanes are reconstructed from each block's stream — the node's RPC does not expose the seal algorithm directly." : ""}</p>
      <div class="mt-3 space-y-2.5">
        {Object.entries(n.sealLanes).map(([k, v]: any) => (
          <div>
            <div class="flex items-center justify-between text-sm"><span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full" style={`background:${SEAL_TONE[k]}`}></span>{SEAL_LABEL[k]}</span><span class="font-mono text-muted">{v}</span></div>
            <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-[rgba(255,255,255,0.05)]"><div class="h-full rounded-full" style={`width:${Math.round((Number(v) / laneTotal) * 100)}%;background:${SEAL_TONE[k]}`}></div></div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- node identity -->
  {n.nodeInfo && (
    <div class="card mt-5 p-5">
      <h3 class="text-base font-bold">Queried node</h3>
      <dl class="mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        <div class="min-w-0"><dt class="text-xs font-semibold uppercase tracking-wider text-faint">Peer ID</dt><dd class="mt-0.5 break-all font-mono text-sm text-muted">{n.nodeInfo.peerId}</dd></div>
        <div class="min-w-0"><dt class="text-xs font-semibold uppercase tracking-wider text-faint">P2P port</dt><dd class="mt-0.5 font-mono text-sm text-muted">{n.nodeInfo.p2pPort}</dd></div>
        <div class="min-w-0 sm:col-span-2"><dt class="text-xs font-semibold uppercase tracking-wider text-faint">Listen addresses</dt><dd class="mt-0.5 space-y-0.5">{n.nodeInfo.listenAddrs.map((a: string) => <div class="break-all font-mono text-xs text-faint">{a}</div>)}</dd></div>
      </dl>
    </div>
  )}

  <!-- peers -->
  {n.peers && n.peers.length > 0 && (
    <>
      <h2 class="mt-6 text-lg font-bold">Connected peers ({n.peers.length})</h2>
      <div class="card mt-2 overflow-hidden p-0">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-line text-left text-xs uppercase tracking-wider text-faint">
              <th class="px-4 py-3 font-semibold">Peer</th><th class="px-4 py-3 font-semibold">Address</th><th class="px-4 py-3 font-semibold">Dir</th><th class="px-4 py-3 font-semibold">Height</th><th class="px-4 py-3 text-right font-semibold">Latency</th>
            </tr></thead>
            <tbody>
              {n.peers.map((p: any) => (
                <tr class="border-b border-line-soft last:border-0 hover:bg-[rgba(255,255,255,0.02)]">
                  <td class="px-4 py-3 font-mono text-xs text-muted">{shortHash(p.id, 8)}</td>
                  <td class="px-4 py-3 font-mono text-xs text-faint">{p.addr}</td>
                  <td class="px-4 py-3 text-xs capitalize text-muted">{p.direction}</td>
                  <td class="px-4 py-3 font-mono text-muted">{p.height ? "#" + fmtNum(p.height) : "—"}</td>
                  <td class="px-4 py-3 text-right font-mono text-muted">{p.latency ? p.latency + " ms" : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </>
  )}
</Shell>
