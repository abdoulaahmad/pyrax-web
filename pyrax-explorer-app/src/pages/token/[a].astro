---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../../layouts/Shell.astro";
import { selectedChainId, netFor, getToken } from "../../server/chain";
import { shortHash, shortAddr, fmtNum, timeAgo } from "../../lib/format";
const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const { a } = Astro.params;
const t: any = await getToken(net, a!);
const sample = t.source === "sample";
const KIND_TONE: Record<string, string> = { "ERC-20": "#f58622", "ERC-721": "#7c5cff", "ERC-1155": "#60b8cc" };
const tone = KIND_TONE[t.kind] || "#f58622";
const transfers: any[] = t.transfersList || [];
---
<Shell title="Token" description="A token on PYRAX — standard, metadata and recent transfers.">
  <div class="flex flex-wrap items-center gap-2">
    <a href="/tokens" class="text-sm text-muted hover:text-ink">← Tokens</a>
    <h1 class="text-2xl font-extrabold">Token</h1>
    <span class="rounded-md px-1.5 py-0.5 text-[0.62rem] font-bold" style={`color:${tone};background:${tone}1a`}>{t.kind}</span>
    {t.verified && <span class="chip" style="color:var(--color-positive);border-color:rgba(52,211,153,.4)">✓ verified</span>}
    {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <span class="grid h-9 w-9 place-items-center rounded-full text-xs font-bold" style={`color:${tone};background:${tone}1a`}>{String(t.symbol).slice(0, 3)}</span>
    <span class="text-lg font-bold text-ink">{t.name} <span class="text-muted">· {t.symbol}</span></span>
    <code class="block break-all font-mono text-sm text-muted">{t.address}</code>
  </div>

  <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Standard</div><div class="mt-1 text-2xl font-extrabold">{t.kind}</div></div>
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Decimals</div><div class="mt-1 text-2xl font-extrabold">{fmtNum(t.decimals)}</div></div>
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Holders</div><div class="mt-1 text-2xl font-extrabold">{fmtNum(t.holders)}</div></div>
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Transfers</div><div class="mt-1 text-2xl font-extrabold">{fmtNum(t.transfers)}</div></div>
  </div>

  <div class="card mt-5 p-5">
    <div class="flex items-center justify-between text-sm">
      <span class="text-xs font-semibold uppercase tracking-wider text-faint">Total supply</span>
      <span class="font-mono text-ink">{t.supply}</span>
    </div>
  </div>

  <h2 class="mt-6 text-lg font-bold">Recent transfers</h2>
  <div class="card mt-2 overflow-hidden p-0">
    {transfers.length === 0 ? <div class="p-8 text-center text-sm text-muted">No transfers indexed yet{net.rpc ? "" : " (network offline)"}.</div> : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-line text-left text-xs uppercase tracking-wider text-faint">
            <th class="px-4 py-3 font-semibold">Tx</th><th class="px-4 py-3 font-semibold">From → To</th><th class="px-4 py-3 font-semibold">Block</th><th class="px-4 py-3 font-semibold">Age</th><th class="px-4 py-3 text-right font-semibold">Amount</th>
          </tr></thead>
          <tbody>
            {transfers.map((x: any) => (
              <tr class="border-b border-line-soft last:border-0 hover:bg-[rgba(255,255,255,0.02)]">
                <td class="px-4 py-3"><a href={`/tx/${x.txHash}`} class="font-mono text-[color:var(--color-brand)]">{shortHash(x.txHash)}</a></td>
                <td class="px-4 py-3 font-mono text-xs text-muted">{shortAddr(x.from)} → {x.to ? shortAddr(x.to) : "—"}</td>
                <td class="px-4 py-3"><a href={`/block/${x.block}`} class="font-mono text-muted hover:text-ink">#{fmtNum(x.block)}</a></td>
                <td class="px-4 py-3 text-muted">{x.timestamp ? timeAgo(x.timestamp) : "—"}</td>
                <td class="px-4 py-3 text-right font-mono text-ink">{x.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Shell>
