---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getGas } from "../server/chain";
import { fmtNum } from "../lib/format";

const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const g: any = await getGas(net);
const sample = g.source === "sample";
const hist = g.history as { block: number; baseFee: number; gasUsedRatio: number }[];
const maxBase = Math.max(0.001, ...hist.map((h) => h.baseFee));
const tiers = [
  { key: "low", label: "Low", tone: "#34d399", desc: "~5 min" },
  { key: "avg", label: "Average", tone: "#f58622", desc: "~1 min" },
  { key: "high", label: "High", tone: "#fb6f73", desc: "next block" },
];
---
<Shell title="Gas Tracker" description="EIP-1559 fees on PYRAX — base fee, suggested priority tips and per-block utilization.">
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-extrabold sm:text-3xl">Gas Tracker</h1>
    {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <p class="mt-1 text-sm text-muted">PYRAX uses an EIP-1559 fee market: a protocol <span class="text-ink">base fee</span> (burned/redistributed per tokenomics) plus an optional <span class="text-ink">priority tip</span> to validators.</p>

  <!-- fee tiers -->
  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    {tiers.map((t) => (
      <div class="card p-5 text-center">
        <div class="text-xs font-semibold uppercase tracking-wider" style={`color:${t.tone}`}>{t.label}</div>
        <div class="mt-1 text-3xl font-extrabold">{g.tiers[t.key]}</div>
        <div class="text-xs text-faint">gwei · {t.desc}</div>
      </div>
    ))}
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-3">
    <div class="card p-5">
      <div class="text-xs font-semibold uppercase tracking-wider text-faint">Current base fee</div>
      <div class="mt-1 text-2xl font-extrabold flame-text">{g.baseFee} gwei</div>
      <div class="mt-4 text-xs font-semibold uppercase tracking-wider text-faint">Avg block utilization</div>
      <div class="mt-1 text-2xl font-extrabold">{g.avgUtil}%</div>
      <p class="mt-3 text-xs text-muted">Base fee rises when blocks run above the 50% gas target and falls when below — keeping average utilization near target.</p>
    </div>

    <!-- base-fee history chart -->
    <div class="card p-5 lg:col-span-2">
      <h3 class="text-base font-bold">Base fee · last {hist.length} blocks</h3>
      <div class="mt-4 flex h-40 items-end gap-1">
        {hist.map((h) => (
          <div class="group relative flex flex-1 flex-col items-center justify-end" title={`#${fmtNum(h.block)} · ${h.baseFee} gwei · ${Math.round(h.gasUsedRatio * 100)}% used`}>
            <div class="w-full rounded-t" style={`height:${Math.max(3, (h.baseFee / maxBase) * 100)}%;background:linear-gradient(180deg,var(--color-brand),var(--color-ember));opacity:${0.45 + h.gasUsedRatio * 0.55}`}></div>
          </div>
        ))}
      </div>
      <div class="mt-2 flex justify-between text-[0.7rem] text-faint"><span>#{fmtNum(hist[0]?.block)}</span><span>bar height = base fee · opacity = gas used</span><span>#{fmtNum(hist[hist.length - 1]?.block)}</span></div>
    </div>
  </div>

  <!-- utilization table -->
  <h2 class="mt-6 text-lg font-bold">Recent blocks</h2>
  <div class="card mt-2 overflow-hidden p-0">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-line text-left text-xs uppercase tracking-wider text-faint">
          <th class="px-4 py-3 font-semibold">Block</th><th class="px-4 py-3 font-semibold">Base fee</th><th class="px-4 py-3 font-semibold">Gas used</th><th class="px-4 py-3 font-semibold">Utilization</th>
        </tr></thead>
        <tbody>
          {[...hist].reverse().slice(0, 12).map((h) => (
            <tr class="border-b border-line-soft last:border-0 hover:bg-[rgba(255,255,255,0.02)]">
              <td class="px-4 py-3"><a href={`/block/${h.block}`} class="font-mono text-[color:var(--color-brand)]">#{fmtNum(h.block)}</a></td>
              <td class="px-4 py-3 font-mono text-muted">{h.baseFee.toFixed(3)} gwei</td>
              <td class="px-4 py-3 font-mono text-muted">{Math.round(h.gasUsedRatio * 100)}%</td>
              <td class="px-4 py-3"><div class="h-1.5 w-32 overflow-hidden rounded-full bg-[rgba(255,255,255,0.05)]"><div class="h-full rounded-full" style={`width:${Math.round(h.gasUsedRatio * 100)}%;background:${h.gasUsedRatio > 0.5 ? "var(--color-ember)" : "var(--color-positive)"}`}></div></div></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Shell>
