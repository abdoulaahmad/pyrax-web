---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import VerifyForm from "../components/VerifyForm.tsx";
---
<Shell title="Verify a contract" description="Compile and match Solidity source against on-chain bytecode to publish a verified PYRAX contract.">
  <h1 class="text-2xl font-extrabold sm:text-3xl">Verify a contract</h1>
  <p class="mt-1 max-w-2xl text-sm text-muted">Submit your Solidity source and compiler settings. The verifier compiles it, strips the CBOR metadata tail, and matches the result against the deployed bytecode on the selected network — then publishes the verified source, ABI and read/write interface.</p>
  <div class="mt-5 grid gap-6 lg:grid-cols-[1fr_280px]">
    <VerifyForm client:load />
    <aside class="space-y-4">
      <div class="card p-5">
        <h3 class="text-sm font-bold">How it works</h3>
        <ol class="mt-2 space-y-2 text-xs text-muted">
          <li><span class="font-bold text-ink">1.</span> Confirm the address holds bytecode (eth_getCode).</li>
          <li><span class="font-bold text-ink">2.</span> Compile the source with the exact compiler + optimizer settings.</li>
          <li><span class="font-bold text-ink">3.</span> Strip the trailing metadata hash and compare runtime bytecode.</li>
          <li><span class="font-bold text-ink">4.</span> On a match, publish source + ABI to the contract page.</li>
        </ol>
      </div>
      <div class="card p-5">
        <h3 class="text-sm font-bold">Supported VMs</h3>
        <p class="mt-1.5 text-xs text-muted">Solidity (EVM) verification is supported here. Rust/WASM and Cairo verification follow as the node exposes their build metadata.</p>
      </div>
    </aside>
  </div>
</Shell>
