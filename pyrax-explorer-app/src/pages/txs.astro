---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getTxs } from "../server/chain";
import LiveTxs from "../components/LiveTxs.tsx";
const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const PAGE = 25;
const offset = Math.max(0, Number(Astro.url.searchParams.get("offset")) || 0);
// SSR seed for the island (client:load server-renders it), then it polls /api/txs every ~5s to keep the
// table live without a full page reload. The ?offset= cursor is passed through so a paged view keeps
// polling its own page.
const { source, txs } = await getTxs(net, { limit: PAGE, offset });
---
<Shell title="Transactions">
  <LiveTxs client:load initial={txs} initialSource={source} offset={offset} />
</Shell>
