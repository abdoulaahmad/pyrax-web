---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../../layouts/Shell.astro";
import { selectedChainId, netFor, getContract } from "../../server/chain";
import { fmtNum, timeAgo } from "../../lib/format";
const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const { a } = Astro.params;
const c: any = await getContract(net, a!);
const sample = c.source === "sample";
const VM = (c.vm || "evm").toUpperCase();
let abi: any[] = [];
try { abi = c.abi ? JSON.parse(c.abi) : []; } catch {}
const functions = abi.filter((x: any) => x.type === "function");
const events = abi.filter((x: any) => x.type === "event");
const meta = [
  ["Compiler", c.compiler || "—"],
  ["Language", c.language || "Solidity"],
  ["Optimization", c.optimization == null ? "—" : c.optimization ? `enabled · ${fmtNum(c.runs ?? 200)} runs` : "disabled"],
  ["EVM version", c.evmVersion || "—"],
  ["Code size", c.codeSize ? `${fmtNum(c.codeSize)} bytes` : "—"],
  ["Verified", c.verifiedAt ? timeAgo(c.verifiedAt) : c.verified ? "yes" : "not verified"],
] as const;
---
<Shell title="Contract" description="A deployed PYRAX contract — verification status, ABI and source.">
  <div class="flex flex-wrap items-center gap-2">
    <a href="/contracts" class="text-sm text-muted hover:text-ink">← Contracts</a>
    <h1 class="text-2xl font-extrabold">Contract</h1>
    <span class="chip" style="color:var(--color-brand);border-color:rgba(245,134,34,.4)">{VM}</span>
    {c.verified
      ? <span class="chip" style="color:var(--color-positive);border-color:rgba(52,211,153,.4)">✓ verified</span>
      : <span class="chip chip-muted">unverified</span>}
    {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <span class="text-lg font-bold text-ink">{c.name}</span>
    <code class="block break-all font-mono text-sm text-muted">{c.address}</code>
  </div>

  <div class="mt-5 grid gap-4 sm:grid-cols-3">
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Balance</div><div class="mt-1 text-2xl font-extrabold flame-text">{c.balance}</div><div class="text-xs text-faint">PYRX</div></div>
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Functions</div><div class="mt-1 text-2xl font-extrabold">{fmtNum(functions.length)}</div></div>
    <div class="card p-5"><div class="text-xs font-semibold uppercase tracking-wider text-faint">Events</div><div class="mt-1 text-2xl font-extrabold">{fmtNum(events.length)}</div></div>
  </div>

  <div class="card mt-5 p-5">
    <h3 class="text-base font-bold">Compiler &amp; verification</h3>
    <dl class="mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2">
      {meta.map(([k, v]) => (
        <div class="min-w-0"><dt class="text-xs font-semibold uppercase tracking-wider text-faint">{k}</dt><dd class="mt-0.5 font-mono text-sm text-muted">{v}</dd></div>
      ))}
    </dl>
    {!c.verified && <p class="mt-4 text-sm text-muted">Source not verified. Publish and verify your source on the <a href="/verify" class="text-[color:var(--color-brand)]">Verify</a> page.</p>}
  </div>

  {abi.length > 0 && (
    <div class="card mt-5 overflow-hidden p-0">
      <div class="border-b border-line px-5 py-3"><h3 class="text-base font-bold">ABI ({abi.length} entries)</h3></div>
      <div class="max-h-[20rem] divide-y divide-[color:var(--color-line-soft)] overflow-y-auto">
        {abi.map((x: any) => (
          <div class="flex items-center justify-between gap-3 px-5 py-2.5 text-sm">
            <div class="flex items-center gap-2.5">
              <span class="rounded-md px-1.5 py-0.5 text-[0.6rem] font-bold uppercase" style={`color:${x.type === "event" ? "#34d399" : x.type === "function" ? "#f58622" : "#9aa4ba"};background:${x.type === "event" ? "#34d39922" : x.type === "function" ? "#f5862222" : "#9aa4ba22"}`}>{x.type}</span>
              <code class="font-mono text-ink">{x.name || "—"}</code>
            </div>
            {x.stateMutability && <span class="font-mono text-xs text-faint">{x.stateMutability}</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  {c.sourceCode && (
    <div class="card mt-5 overflow-hidden p-0">
      <div class="border-b border-line px-5 py-3"><h3 class="text-base font-bold">Source code</h3></div>
      <pre class="max-h-[28rem] overflow-auto bg-[rgba(5,6,9,0.5)] p-4 font-mono text-xs leading-relaxed text-muted">{c.sourceCode}</pre>
    </div>
  )}
</Shell>
