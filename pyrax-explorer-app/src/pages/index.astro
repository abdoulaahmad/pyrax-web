---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getOverview } from "../server/chain";
import { SEAL_LABEL, STREAM_LABEL, TX_TYPE_LABEL } from "../server/sample";
import { shortHash, shortAddr, fmtNum, timeAgo, TX_TYPE_TONE, STREAM_TONE } from "../lib/format";

const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const o = await getOverview(net);
const sample = o.source === "sample";
const streamTotal = Math.max(1, (o.streamCounts.A || 0) + (o.streamCounts.B || 0) + (o.streamCounts.C || 0));
const tiles = [
  { label: "Block height", value: "#" + fmtNum(o.height), sub: `blue score ${fmtNum(o.blueScore)}`, accent: "brand" },
  { label: "Finalized", value: "#" + fmtNum(o.finalizedHeight), sub: "Stream C · BFT", accent: "positive" },
  { label: "Gas price", value: o.gasPrice + " gwei", sub: `base fee ${o.baseFee}`, accent: "water" },
  { label: "Shielded notes", value: fmtNum(o.shielded.noteCount), sub: `${fmtNum(o.shielded.nullifierCount)} nullifiers`, accent: "violet" },
];
---
<Shell title="Overview" description={`PYRAX ${net.name} block explorer — live blocks, transactions, DAG streams, contracts and the shielded pool.`}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <h1 class="text-2xl font-extrabold sm:text-3xl">{net.name} <span class="text-faint">Explorer</span></h1>
        {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample data · node offline</span>}
      </div>
      <p class="mt-1 text-sm text-muted">GhostDAG · TriStream consensus · chain {net.chainId} · {o.streamMode}</p>
    </div>
    <div class="text-sm text-muted">{o.tps !== "—" ? `${o.tps} TPS` : ""}{o.peers ? ` · ${o.peers} peers` : ""}</div>
  </div>

  <!-- stat tiles -->
  <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {tiles.map((t) => (
      <div class="card p-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-faint">{t.label}</div>
        <div class={`mt-1.5 text-2xl font-extrabold ${t.accent === "brand" ? "flame-text" : ""}`} style={t.accent !== "brand" ? `color:var(--color-${t.accent === "violet" ? "ink" : t.accent})` : ""}>{t.value}</div>
        <div class="mt-0.5 text-xs text-faint">{t.sub}</div>
      </div>
    ))}
  </div>

  <div class="mt-5 grid gap-5 lg:grid-cols-3">
    <!-- TriStream distribution -->
    <div class="card p-5">
      <h3 class="text-base font-bold">TriStream consensus</h3>
      <p class="text-xs text-muted">Block production across the three emission streams (recent window).</p>
      <div class="mt-4 space-y-3">
        {(["A", "B", "C"] as const).map((s) => (
          <div>
            <div class="flex items-center justify-between text-sm"><span class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full" style={`background:${STREAM_TONE[s]};box-shadow:0 0 8px ${STREAM_TONE[s]}`}></span>{STREAM_LABEL[s]}</span><span class="font-mono text-muted">{o.streamCounts[s] || 0}</span></div>
            <div class="mt-1 h-2 overflow-hidden rounded-full bg-[rgba(255,255,255,0.05)]"><div class="h-full rounded-full" style={`width:${Math.round(((o.streamCounts[s] || 0) / streamTotal) * 100)}%;background:${STREAM_TONE[s]}`}></div></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Shielded pool -->
    <div class="card p-5">
      <h3 class="flex items-center gap-2 text-base font-bold"><svg viewBox="0 0 24 24" class="h-4 w-4 text-[color:#7c5cff]" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6v5c0 4.5 3 7.8 7 9 4-1.2 7-4.5 7-9V6l-7-3Z"/></svg> Shielded pool</h3>
      <p class="text-xs text-muted">Privacy-preserving note pool — only structural stats are public.</p>
      <div class="mt-4 space-y-2.5 text-sm">
        <div class="flex justify-between"><span class="text-muted">Note commitments</span><span class="font-mono text-ink">{fmtNum(o.shielded.noteCount)}</span></div>
        <div class="flex justify-between"><span class="text-muted">Nullifiers spent</span><span class="font-mono text-ink">{fmtNum(o.shielded.nullifierCount)}</span></div>
        <div class="flex justify-between"><span class="text-muted">Shielded tx share</span><span class="font-mono text-[color:#7c5cff]">{o.shielded.shieldedTxShare === "—" ? "—" : o.shielded.shieldedTxShare + "%"}</span></div>
        <div class="flex items-center justify-between gap-2"><span class="text-muted">Anchor</span><code class="truncate font-mono text-xs text-faint" title={o.shielded.anchor}>{shortHash(o.shielded.anchor)}</code></div>
      </div>
      <a href="/shielded" class="mt-4 inline-flex text-sm font-semibold text-[color:#7c5cff]">Explore the shielded pool →</a>
    </div>

    <!-- Supply -->
    <div class="card p-5">
      <h3 class="text-base font-bold">Supply</h3>
      <p class="text-xs text-muted">PYRX — 50B hard cap (37.5B premine + 12.5B emissions).</p>
      <div class="mt-4"><div class="text-2xl font-extrabold flame-text">{o.supplyCirculating}</div><div class="text-xs text-faint">of {o.supplyCap} PYRX cap</div></div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-[rgba(255,255,255,0.05)]"><div class="h-full flame-bar" style="width:75%"></div></div>
      <div class="mt-3 grid grid-cols-2 gap-2 text-xs text-muted"><span>Base fee → 50% treasury · 25% DAO</span><span>Tip → 20% / 10%</span></div>
    </div>
  </div>

  <!-- latest blocks + txs -->
  <div class="mt-5 grid gap-5 lg:grid-cols-2">
    <div class="card overflow-hidden p-0">
      <div class="flex items-center justify-between border-b border-line px-5 py-3"><h3 class="text-base font-bold">Latest blocks</h3><a href="/blocks" class="text-sm text-[color:var(--color-brand)]">View all →</a></div>
      <div class="divide-y divide-[color:var(--color-line-soft)]">
        {o.blocks.map((b: any) => (
          <a href={`/block/${b.number}`} class="flex items-center justify-between gap-3 px-5 py-3 transition hover:bg-[rgba(255,255,255,0.02)]">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-line bg-[rgba(255,255,255,0.02)] text-xs font-bold text-muted">#</span>
              <div><div class="font-mono text-sm font-semibold text-ink">{fmtNum(b.number)}</div><div class="text-xs text-faint">{timeAgo(b.timestamp)} · {b.txCount} txns</div></div>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="rounded-md px-1.5 py-0.5 text-[0.6rem] font-bold" style={`color:${STREAM_TONE[b.stream]};background:${STREAM_TONE[b.stream]}1a`}>{b.stream}</span>
              <span class="hidden rounded-md border border-line px-1.5 py-0.5 text-[0.6rem] text-faint sm:inline">{SEAL_LABEL[b.sealAlgo] || b.sealAlgo}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="card overflow-hidden p-0">
      <div class="flex items-center justify-between border-b border-line px-5 py-3"><h3 class="text-base font-bold">Latest transactions</h3><a href="/txs" class="text-sm text-[color:var(--color-brand)]">View all →</a></div>
      <div class="divide-y divide-[color:var(--color-line-soft)]">
        {o.txs.map((t: any) => (
          <a href={`/tx/${t.hash}`} class="flex items-center justify-between gap-3 px-5 py-3 transition hover:bg-[rgba(255,255,255,0.02)]">
            <div class="min-w-0">
              <div class="flex items-center gap-2"><span class="rounded-md px-1.5 py-0.5 text-[0.6rem] font-bold" style={`color:${TX_TYPE_TONE[t.type]};background:${TX_TYPE_TONE[t.type]}1a`}>{TX_TYPE_LABEL[t.type]}</span><code class="font-mono text-sm text-ink">{shortHash(t.hash)}</code></div>
              <div class="mt-0.5 truncate text-xs text-faint">{t.type === "shielded" ? "shielded — sender & recipient private" : `${shortAddr(t.from)} → ${t.to ? shortAddr(t.to) : "contract creation"}`}</div>
            </div>
            <div class="shrink-0 text-right">
              <div class="font-mono text-sm text-ink">{t.value !== null ? `${t.value} PYRX` : t.valueBalance ? `${t.valueBalance} PYRX` : "—"}</div>
              <div class="text-xs text-faint">{timeAgo(t.timestamp)}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</Shell>
