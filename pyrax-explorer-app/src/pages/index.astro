---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getOverview } from "../server/chain";
import LiveOverview from "../components/LiveOverview.tsx";

const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
// SSR seed: the island is server-rendered with this exact payload (client:load), so the first paint is
// identical to the old snapshot and SEO / no-JS still show real data. The island then polls
// /api/overview every ~5s to keep the tiles + latest blocks/txs live without a full page reload.
const o = await getOverview(net);
---
<Shell title="Overview" description={`PYRAX ${net.name} block explorer — live blocks, transactions, DAG streams, contracts and the shielded pool.`}>
  <LiveOverview client:load initial={o} netName={net.name} chainId={net.chainId} />
</Shell>
