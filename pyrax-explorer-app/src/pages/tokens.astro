---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Shell from "../layouts/Shell.astro";
import { selectedChainId, netFor, getTokens } from "../server/chain";
import { shortAddr, fmtNum } from "../lib/format";

const net = netFor(selectedChainId(Astro.request.headers.get("cookie")));
const PAGE = 50;
const offset = Math.max(0, Number(Astro.url.searchParams.get("offset")) || 0);
const { source, tokens } = await getTokens(net, { limit: PAGE, offset });
const sample = source === "sample";
const KIND_TONE: Record<string, string> = { "ERC-20": "#f58622", "ERC-721": "#7c5cff", "ERC-1155": "#60b8cc" };
---
<Shell title="Tokens" description="ERC-20, ERC-721 and ERC-1155 tokens on PYRAX, ranked by activity.">
  <div class="flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-extrabold sm:text-3xl">Tokens</h1>
    {sample && <span class="rounded-full border border-[color:rgba(252,208,61,0.4)] bg-[rgba(252,208,61,0.08)] px-2 py-0.5 text-[0.66rem] font-semibold uppercase tracking-wider text-[color:var(--color-gold)]">sample</span>}
  </div>
  <p class="mt-1 max-w-2xl text-sm text-muted">Fungible and non-fungible tokens discovered from on-chain transfer events on the EVM. Live holder counts and supply via <span class="text-ink">eth_call</span> land with the indexer's transfer table.</p>

  <div class="card mt-5 overflow-hidden p-0">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-line text-left text-xs uppercase tracking-wider text-faint">
          <th class="px-4 py-3 font-semibold">#</th><th class="px-4 py-3 font-semibold">Token</th><th class="px-4 py-3 font-semibold">Standard</th><th class="px-4 py-3 font-semibold">Holders</th><th class="px-4 py-3 font-semibold">Transfers</th><th class="px-4 py-3 text-right font-semibold">Supply</th>
        </tr></thead>
        <tbody>
          {tokens.map((t: any, i: number) => (
            <tr class="border-b border-line-soft last:border-0 hover:bg-[rgba(255,255,255,0.02)]">
              <td class="px-4 py-3 font-mono text-faint">{offset + i + 1}</td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <span class="grid h-8 w-8 place-items-center rounded-full text-[0.62rem] font-bold" style={`color:${KIND_TONE[t.kind]};background:${KIND_TONE[t.kind]}1a`}>{t.symbol.slice(0, 3)}</span>
                  <div><div class="font-semibold text-ink">{t.name} {t.verified && <span class="text-[color:var(--color-positive)]" title="verified">✓</span>}</div><a href={`/address/${t.address}`} class="font-mono text-xs text-faint hover:text-muted">{t.symbol} · {shortAddr(t.address)}</a></div>
                </div>
              </td>
              <td class="px-4 py-3"><span class="rounded-md px-1.5 py-0.5 text-[0.62rem] font-bold" style={`color:${KIND_TONE[t.kind]};background:${KIND_TONE[t.kind]}1a`}>{t.kind}</span></td>
              <td class="px-4 py-3 font-mono text-muted">{fmtNum(t.holders)}</td>
              <td class="px-4 py-3 font-mono text-muted">{fmtNum(t.transfers)}</td>
              <td class="px-4 py-3 text-right font-mono text-muted">{t.supply}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <div class="mt-4 flex items-center justify-between">
    <div class="text-xs text-faint">{offset > 0 ? `rank ${fmtNum(offset + 1)}+` : ""}</div>
    <div class="flex gap-2">
      {offset > 0 && <a class="btn btn-ghost" href={`/tokens?offset=${Math.max(0, offset - PAGE)}`}>← Prev</a>}
      {!sample && tokens.length === PAGE && <a class="btn btn-ghost" href={`/tokens?offset=${offset + PAGE}`}>Next →</a>}
    </div>
  </div>
</Shell>
