import Shell from "../layouts/Shell.astro";
---
<Shell title="Tokens">
  <h1 class="text-2xl font-extrabold sm:text-3xl">Tokens</h1>
  <p class="mt-1 max-w-2xl text-muted">ERC-20, ERC-721 and ERC-1155 tokens discovered from on-chain transfer events.</p>
  <div class="card mt-6 p-8">
    <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-brand)]"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3c1 3 4 4 4 8a4 4 0 0 1-8 0c0-1.5.6-2.3 1.2-3C9.8 9 10 7 9 5c2 .5 3 1.5 3 3 0-1.7 0-3.5 0-5Z"/></svg> In active development</div>
    <p class="mt-1.5 max-w-xl text-sm text-muted">Token registry ranked by activity, with live name/symbol/decimals/supply via eth_call. Needs the indexer's transfer table.</p>
  </div>
</Shell>
