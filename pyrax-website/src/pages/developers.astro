---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../layouts/Site.astro";
import { DEFAULT_LOCALE, localizePath, resolveLocale } from "../i18n/config";
import { useT } from "../i18n";
import { DOMAINS, SOCIAL } from "../lib/endpoints";
import { NETWORKS } from "../lib/networks";
import { headline } from "../lib/headline";

const lang = resolveLocale(Astro.url, Astro.cookies);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);
const seed = NETWORKS[0];

const paths = [
  { t: t("devPage.path1Title", "Deploy a Solidity contract"), d: t("devPage.path1Desc", "Point your existing Ethereum toolchain (Hardhat, Foundry, ethers) at the PYRAX RPC — the full eth_* surface is there."), c: "#f68a24", vm: "EVM" },
  { t: t("devPage.path2Title", "Write a Rust contract"), d: t("devPage.path2Desc", "Compile to WebAssembly and deploy to the WASM VM, metered by the same gas market as everything else."), c: "#34d399", vm: "WASM" },
  { t: t("devPage.path3Title", "Prove with Cairo"), d: t("devPage.path3Desc", "Move heavy computation off-chain and verify a STARK proof on-chain via the Cairo VM."), c: "#7c5cff", vm: "Cairo" },
  { t: t("devPage.path4Title", "Build a shielded dApp"), d: t("devPage.path4Desc", "Use shielded transfers and viewing keys so your users have confidential transfers and your auditors still have read-only proof."), c: "#5cbace", vm: "ZK" },
  { t: t("devPage.path5Title", "PYRAX Compute SDK"), d: t("devPage.path5Desc", "Programmatically escrow and run decentralized GPU workloads — AI inference, training, and rendering with cryptographic execution receipts."), c: "#fed23c", vm: "COMPUTE" },
  { t: t("devPage.path6Title", "Run a node"), d: t("devPage.path6Desc", "Join the mesh with an Inferno node, mine a stream, or stake to validate — no bootstrap server required."), c: "#f5a623", vm: "P2P" },
];

const resources = [
  { t: t("devPage.res1Title", "Documentation"), d: t("devPage.res1Desc", "Guides, architecture, and the JSON-RPC reference."), href: DOMAINS.docs || DOMAINS.site, ext: true, icon: "book" },
  { t: t("devPage.res2Title", "Whitepaper v4"), d: t("devPage.res2Desc", "The full technical paper and a plain-English companion."), href: L("/whitepaper"), ext: false, icon: "book" },
  { t: t("devPage.res3Title", "GitHub"), d: t("devPage.res3Desc", "Apache-2.0 protocol, node, and SDK — read the source."), href: SOCIAL.github, ext: true, icon: "code" },
  { t: t("devPage.res4Title", "Block explorer"), d: t("devPage.res4Desc", "Inspect GhostDAG blocks, the shielded pool, and contracts."), href: DOMAINS.explorer, ext: true, icon: "search" },
  { t: t("devPage.res5Title", "Node & wallet apps"), d: t("devPage.res5Desc", "Desktop node, CLI, and wallet — mesh, mine, shield, stream."), href: DOMAINS.nodes, ext: true, icon: "node" },
  { t: t("devPage.res6Title", "Devnet tester portal"), d: t("devPage.res6Desc", "Join the closed alpha and put PYRAX Forge through its paces."), href: DOMAINS.devnet, ext: true, icon: "flask" },
];

const ICON: Record<string, string> = {
  book: "M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2zM8 3v16",
  code: "m8 8-4 4 4 4M16 8l4 4-4 4",
  search: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14M20 20l-3.5-3.5",
  node: "M12 5a2 2 0 1 0 0-.01M5 18a2 2 0 1 0 0-.01M19 18a2 2 0 1 0 0-.01M12 7v3M8 15l3-4M13 11l3 4",
  flask: "M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3",
};
---
<Site title={t("devPage.eyebrow", "Developers") + " — PYRAX™ Network"} description={t("devPage.subtitle", "Ship Solidity today against the full Ethereum RPC, or reach for Rust, Cairo, shielded transfers, and verifiable compute when you need them.")} lang={lang}>
  
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[14rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.07)">DEV</div>
    <div class="grid-backdrop absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <div class="eyebrow eyebrow-rule text-[color:var(--color-bolt-bright)]">{t("devPage.eyebrow", "Developers")}</div>
        <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold uppercase sm:text-5xl lg:text-6xl tracking-tight leading-[1.04]">
          {headline(t("devPage.headingPre", "Build with the tools you "))} <br />
          <span class="outline-text">{headline(t("devPage.headingEmphasis", "already know"))}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          {t("devPage.subtitle", "Ship Solidity today against the full Ethereum RPC, or reach for Rust, Cairo, shielded transfers, and verifiable compute when you need them. Start free on the always-on Seed sandbox.")}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={DOMAINS.docs || DOMAINS.site} class="rounded-full bg-gradient-to-r from-[color:var(--color-gold)] via-[color:var(--color-brand)] to-[color:var(--color-ember)] px-6 py-3 text-sm font-bold text-[#1a0f06] transition hover:brightness-110">{t("devPage.ctaDocs", "Read the docs →")}</a>
          <a href={SOCIAL.github} class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">{t("devPage.ctaGithub", "GitHub")}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 · QUICKSTART -->
  <section class="scroll-mt-32 relative overflow-hidden border-b border-line px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.06)">01</div>
    <div class="relative mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:items-center">
        <div data-reveal class="max-w-md">
          <div class="eyebrow text-[color:var(--color-brand)]">01 / Quickstart</div>
          <h2 class="mt-4 text-2xl uppercase sm:text-4xl font-display font-extrabold">{headline(t("devPage.connectTitle", "Connect in one step"))}</h2>
          <p class="mt-4 text-sm leading-relaxed text-muted">{t("devPage.connectBody", "The Seed network speaks the standard Ethereum JSON-RPC. Add it to any EVM wallet or framework and you are building — play-money, no signup, always on.")}</p>
          
          <div class="mt-8 grid grid-cols-2 gap-3">
            <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-4">
              <span class="absolute -top-px left-3 h-px w-5 bg-[color:var(--color-brand)]"></span>
              <div class="text-[0.62rem] font-mono uppercase tracking-wider text-faint">{t("devPage.connectNetwork", "Network")}</div>
              <div class="mt-1 font-mono text-sm font-bold text-ink">{seed.name}</div>
            </div>
            <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-4">
              <span class="absolute -top-px left-3 h-px w-5 bg-[color:var(--color-gold)]"></span>
              <div class="text-[0.62rem] font-mono uppercase tracking-wider text-faint">{t("devPage.connectChainId", "Chain ID")}</div>
              <div class="mt-1 font-mono text-sm font-bold text-[color:var(--color-gold)]">{seed.chainId}</div>
            </div>
            <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-4">
              <span class="absolute -top-px left-3 h-px w-5 bg-[color:var(--color-bolt-bright)]"></span>
              <div class="text-[0.62rem] font-mono uppercase tracking-wider text-faint">{t("devPage.connectCurrency", "Currency")}</div>
              <div class="mt-1 font-mono text-sm font-bold text-ink">PYRX</div>
            </div>
            <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-4">
              <span class="absolute -top-px left-3 h-px w-5 bg-[color:var(--color-positive)]"></span>
              <div class="text-[0.62rem] font-mono uppercase tracking-wider text-faint">{t("devPage.connectBlockTime", "Block time")}</div>
              <div class="mt-1 font-mono text-sm font-bold text-ink">{seed.blockTime}s</div>
            </div>
          </div>
        </div>

        <div data-reveal data-reveal-delay="1" class="overflow-hidden rounded-2xl border border-line bg-[#07080d]">
          <div class="flex items-center justify-between border-b border-line-soft px-4 py-3">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-[#fb6f73]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#f5a623]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#34d399]"></span>
              <span class="ml-2 font-mono text-xs text-faint">connect.ts</span>
            </div>
            <span class="rounded bg-white/5 px-2 py-0.5 font-mono text-[0.65rem] text-faint">ethers v6</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[0.78rem] leading-relaxed text-muted"><code>{`import { ethers } from "ethers";

// The always-on PYRAX Seed sandbox.
const rpc = "${seed.rpc}";
const provider = new ethers.JsonRpcProvider(rpc);

const net = await provider.getNetwork();      // chainId ${seed.chainId}
const head = await provider.getBlockNumber(); // GhostDAG height

// Deploy exactly as you would on Ethereum —
// revm gives full eth_* equivalence.
const factory = new ethers.ContractFactory(abi, bytecode, signer);
const contract = await factory.deploy();
await contract.waitForDeployment();`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · EXECUTION FRAMEWORKS -->
  <section class="scroll-mt-32 relative overflow-hidden border-b border-line bg-[color:var(--color-bg-2)] px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.06)">02</div>
    <div class="relative mx-auto max-w-6xl">
      <div data-reveal class="max-w-2xl">
        <div class="eyebrow text-[#a78bfa]">02 / Execution Frameworks</div>
        <h2 class="mt-4 text-2xl uppercase sm:text-4xl font-display font-extrabold">{headline(t("devPage.pathsTitle", "Pick your path"))}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">{t("devPage.pathsSubtitle", "Six ways to build on PYRAX — from a familiar Solidity deploy to shielded dApps and verifiable AI.")}</p>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {paths.map((p, i) => (
          <div data-reveal data-reveal-delay={String((i % 3) + 1)} class="group relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-6 transition hover:border-[color:var(--color-line-soft)] hover:bg-[color:var(--color-elevated)]">
            <span class="absolute -top-px left-4 h-px w-6" style={`background:${p.c}`}></span>
            <div class="flex items-center justify-between">
              <span class="font-mono text-[0.62rem] text-faint">PATH 0{i + 1}</span>
              <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[0.65rem] font-bold" style={`color:${p.c}`}>{p.vm}</span>
            </div>
            <h3 class="mt-4 font-display text-base font-bold text-ink">{p.t}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · RESOURCES -->
  <section class="scroll-mt-32 relative overflow-hidden px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.06)">03</div>
    <div class="relative mx-auto max-w-6xl">
      <div data-reveal class="max-w-2xl">
        <div class="eyebrow text-[color:var(--color-gold)]">03 / Developer Resources</div>
        <h2 class="mt-4 text-2xl uppercase sm:text-4xl font-display font-extrabold">{headline(t("devPage.resourcesTitle", "Resources"))}</h2>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {resources.map((r, i) => (
          <a data-reveal data-reveal-delay={String((i % 3) + 1)} href={r.href} class="group relative flex items-start gap-4 rounded-2xl border border-line bg-[color:var(--color-surface)] p-6 transition hover:border-[color:var(--color-line-soft)] hover:bg-[color:var(--color-elevated)]">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-line bg-[color:var(--color-bg-2)] text-[color:var(--color-brand)] transition group-hover:border-[color:var(--color-brand)] group-hover:text-[color:var(--color-gold)]">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[r.icon]}/></svg>
            </span>
            <span class="flex-1">
              <span class="flex items-center gap-1.5 font-display text-base font-bold text-ink group-hover:text-[color:var(--color-brand)]">
                {r.t}
                {r.ext && <svg viewBox="0 0 24 24" class="h-3 w-3 text-faint transition group-hover:text-ink" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg>}
              </span>
              <span class="mt-1.5 block text-xs leading-relaxed text-muted">{r.d}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-14 flex flex-wrap items-center gap-3">
        <a href={DOMAINS.docs || DOMAINS.site} class="rounded-full bg-gradient-to-r from-[color:var(--color-gold)] via-[color:var(--color-brand)] to-[color:var(--color-ember)] px-6 py-3 text-sm font-bold text-[#1a0f06] transition hover:brightness-110">{t("devPage.ctaDocs", "Read the docs →")}</a>
        <a href={L("/network")} class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">The four networks</a>
        <a href={DOMAINS.explorer} class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">Open the explorer</a>
      </div>
    </div>
  </section>
</Site>
