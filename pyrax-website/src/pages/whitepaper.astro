---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../layouts/Site.astro";
import { DEFAULT_LOCALE, localizePath, resolveLocale } from "../i18n/config";
import { useT } from "../i18n";
import { headline } from "../lib/headline";

const lang = resolveLocale(Astro.url, Astro.cookies);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);

const TECH = "/whitepaper/pyrax-whitepaper-v4-technical.pdf";
const PLAIN = "/whitepaper/pyrax-whitepaper-v4-plain-english.pdf";

const northStars = [
  { n: "01", t: t("wpPage.northStar1Title", "DAG, not a chain"), d: t("wpPage.northStar1Desc", "A multi-parent DAG ordered by GhostDAG — honest parallel work is included, not orphaned."), c: "#f68a24" },
  { n: "02", t: t("wpPage.northStar2Title", "Opt-in privacy"), d: t("wpPage.northStar2Desc", "Transactions are transparent by default for native liquidity, with optional no-trusted-setup zk-SNARK shielded pools for confidential transfers."), c: "#7c5cff" },
  { n: "03", t: t("wpPage.northStar3Title", "No boot node"), d: t("wpPage.northStar3Desc", "Peer discovery is bootstrapless — mDNS, Kademlia, peer exchange, and a signed seed list. No project server to join."), c: "#34d399" },
  { n: "04", t: t("wpPage.northStar4Title", "P2P resilience"), d: t("wpPage.northStar4Desc", "Bootstrapless peer discovery and client-driven gossip — no corporate choke point, centralized bootstrap authority, or relay monopoly."), c: "#5cbace" },
  { n: "05", t: t("wpPage.northStar5Title", "Open & verifiable"), d: t("wpPage.northStar5Desc", "The protocol, consensus, ZK circuits, CLI, and SDK are Apache-2.0. A chain with secret rules is not trustless."), c: "#fed23c" },
];

const toc = [
  t("wpPage.toc1", "Design Goals — Five North Stars"), t("wpPage.toc2", "Architecture Overview"), t("wpPage.toc3", "Performance & Scalability"), t("wpPage.toc4", "Consensus: GhostDAG + TriStream + BLS PoS"), t("wpPage.toc5", "Privacy: Opt-In Shielded Transfers"), t("wpPage.toc6", "Execution: Multi-VM L2"), t("wpPage.toc7", "L3 — Recursive ZK Rollup"), t("wpPage.toc8", "Networking: Bootstrapless Discovery"), t("wpPage.toc9", "Network Layer & Peer-to-Peer Mesh"), t("wpPage.toc10", "State, Storage & Proofs"), t("wpPage.toc11", "PYRAX Compute — Verifiable Market"), t("wpPage.toc12", "Crucible — Zero-Fee Mining"), t("wpPage.toc13", "NOVA — Autonomous Operations"), t("wpPage.toc14", "Tokenomics"), t("wpPage.toc15", "Governance & the DAO"), t("wpPage.toc16", "The Four Networks"), t("wpPage.toc17", "Wallet, Apps, CLI & SDK"), t("wpPage.toc18", "RPC Surface"), t("wpPage.toc19", "Cryptographic Primitives"),
];
---
<Site title="Whitepaper v4 — PYRAX Network" description="The PYRAX v4 whitepaper: a from-scratch Rust Layer-1 with a GhostDAG, TriStream consensus, BLS proof-of-stake finality, opt-in shielded privacy, a multi-VM execution layer, and the PYRAX Compute market. Technical and plain-English editions." lang={lang}>
  
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[14rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.07)">SPEC</div>
    <div class="grid-backdrop absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2 eyebrow eyebrow-rule text-[color:var(--color-gold)]">
          {t("wpPage.eyebrow", "Whitepaper")} <span class="rounded-full border border-line px-2 py-0.5 text-faint font-mono text-[0.68rem]">{t("wpPage.eyebrowVersion", "v4")}</span>
        </div>
        <h1 class="mt-4 max-w-4xl font-display text-3xl font-extrabold uppercase sm:text-5xl lg:text-6xl tracking-tight leading-[1.04]">
          {headline(t("wpPage.headingPre", "A system that is "))}<span class="flame-text">{headline(t("wpPage.headingWord", "built"))}</span> <br />
          <span class="outline-text">{headline(t("wpPage.headingPost", ", not merely designed").replace(/^,\s*/, ''))}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
          {t("wpPage.subtitle", "v4 specifies the complete PYRAX architecture — one modular binary across four network chainspecs, with production consensus and cryptographic execution paths actively engineered and gated to mainnet by external audit.")}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <button type="button" disabled class="cursor-not-allowed inline-flex items-center justify-center gap-2 rounded-full border border-line bg-[rgba(255,255,255,0.03)] px-6 py-3 text-sm font-semibold text-muted opacity-80">
            <span>{t("wpPage.downloadTechnical", "Download technical paper")}</span>
            <span class="rounded-full border border-[color:var(--color-brand)] bg-[rgba(246,138,36,0.12)] px-2 py-0.5 text-[0.68rem] font-semibold text-[color:var(--color-brand)]">{t("wpPage.statusUnderRevision", "Under revision")}</span>
          </button>
          <button type="button" disabled class="cursor-not-allowed inline-flex items-center justify-center gap-2 rounded-full border border-line bg-[rgba(255,255,255,0.03)] px-6 py-3 text-sm font-semibold text-muted opacity-80">
            <span>{t("wpPage.downloadPlain", "Plain-English edition")}</span>
            <span class="rounded-full border border-line bg-[rgba(255,255,255,0.06)] px-2 py-0.5 text-[0.68rem] font-semibold text-faint">{t("wpPage.statusComingSoon", "Coming soon")}</span>
          </button>
        </div>

        <p class="mt-4 flex items-center gap-2 text-xs text-faint">
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-[color:var(--color-brand)]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          {t("wpPage.downloadsPausedBanner", "Whitepaper downloads are temporarily paused while v4 is undergoing formal revisions. You can explore the system overview and section outline below.")}
        </p>
      </div>
    </div>
  </section>

  <!-- 01 · EXECUTIVE ABSTRACT -->
  <section class="scroll-mt-32 relative overflow-hidden border-b border-line px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.06)">01</div>
    <div class="relative mx-auto max-w-6xl">
      <div data-reveal class="max-w-3xl">
        <div class="eyebrow text-[color:var(--color-brand)]">01 / Executive Abstract</div>
        <h2 class="mt-4 text-2xl uppercase sm:text-4xl font-display font-extrabold">{headline(t("wpPage.abstractLabel", "Abstract"))}</h2>
      </div>

      <div data-reveal data-reveal-delay="1" class="mt-10 relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-8">
        <span class="absolute -top-px left-6 h-px w-8 bg-[color:var(--color-gold)]"></span>
        <div class="font-mono text-xs uppercase tracking-wider text-faint mb-3">Specification Synopsis</div>
        <p class="text-sm leading-relaxed text-muted">
          {t("wpPage.abstractPara1a", "PYRAX is a from-scratch, Rust-implemented Layer-1 organized around four properties most networks bolt on but PYRAX enforces as invariants: ")}
          <span class="text-ink font-semibold">{t("wpPage.abstractPara1b", "high throughput, multi-VM execution, hybrid consensus, and verifiable AI compute.")}</span>
          {t("wpPage.abstractPara1c", " Consensus is a DAG ordered by GhostDAG, fed by a TriStream model — two proof-of-work families across four seal lanes plus proof-of-stake — and finalized by BLS-aggregated proof-of-stake BFT.")}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          {t("wpPage.abstractPara2a", "Value transfer is transparent by default with an optional Orchard-style shielded note model and recursive zk-SNARKs that need no trusted setup. The peer layer is bootstrapless, execution scales through a multi-VM L2 (EVM, WASM, Cairo) and a recursive ZK-rollup L3, and the same idle GPUs that mine Stream B power ")}
          <span class="text-ink font-semibold">PYRAX Compute</span>
          {t("wpPage.abstractPara2c", ", a verifiable on-chain-settled compute market.")}
        </p>
      </div>
    </div>
  </section>

  <!-- 02 · FIVE NORTH STARS -->
  <section class="scroll-mt-32 relative overflow-hidden border-b border-line bg-[color:var(--color-bg-2)] px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.06)">02</div>
    <div class="relative mx-auto max-w-6xl">
      <div data-reveal class="max-w-3xl">
        <div class="eyebrow text-[#a78bfa]">02 / Design Principles</div>
        <h2 class="mt-4 text-2xl uppercase sm:text-4xl font-display font-extrabold">{headline(t("wpPage.northStarsTitle", "Five north stars"))}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">{t("wpPage.northStarsSubtitle", "Constraints, not aspirations — the foundation crates encode them so every later layer is built against them.")}</p>
      </div>

      <div class="mt-10 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-5">
        {northStars.map((s, i) => (
          <div data-reveal data-reveal-delay={String((i % 5) + 1)} class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-5 transition hover:border-[color:var(--color-line-soft)]">
            <span class="absolute -top-px left-3.5 h-px w-6" style={`background:${s.c}`}></span>
            <div class="font-mono text-xs font-bold" style={`color:${s.c}`}>{s.n}</div>
            <h3 class="mt-3 font-display text-sm font-bold text-ink">{s.t}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · TOC & EDITIONS -->
  <section class="scroll-mt-32 relative overflow-hidden px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.06)">03</div>
    <div class="relative mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.35fr]">
        <div data-reveal class="max-w-md">
          <div class="eyebrow text-[color:var(--color-gold)]">03 / Documentation & Index</div>
          <h2 class="mt-4 text-2xl uppercase sm:text-4xl font-display font-extrabold">{headline(t("wpPage.editionsTitle", "Two editions"))}</h2>
          <p class="mt-4 text-sm leading-relaxed text-muted">{t("wpPage.editionsBody", "The technical paper is the full specification. The plain-English edition explains the same system without the mathematics — start there if PYRAX is new to you.")}</p>

          <div class="mt-8 space-y-3">
            <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-5">
              <span class="absolute -top-px left-4 h-px w-6 bg-[color:var(--color-brand)]"></span>
              <div class="flex items-center justify-between">
                <span class="font-display text-sm font-bold text-ink">{t("wpPage.editionTechnicalTitle", "Technical paper")}</span>
                <span class="rounded-full border border-[color:var(--color-brand)] bg-[rgba(246,138,36,0.12)] px-2 py-0.5 text-[0.65rem] font-semibold text-[color:var(--color-brand)]">{t("wpPage.statusUnderRevision", "Under revision")}</span>
              </div>
              <p class="mt-2 text-xs text-faint">{t("wpPage.editionTechnicalDisabledCaption", "19 sections · full specification · downloads paused for revision")}</p>
            </div>

            <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-5">
              <span class="absolute -top-px left-4 h-px w-6 bg-[color:var(--color-gold)]"></span>
              <div class="flex items-center justify-between">
                <span class="font-display text-sm font-bold text-ink">{t("wpPage.editionPlainTitle", "Plain-English edition")}</span>
                <span class="rounded-full border border-[color:var(--color-brand)] bg-[rgba(246,138,36,0.12)] px-2 py-0.5 text-[0.65rem] font-semibold text-[color:var(--color-brand)]">{t("wpPage.statusUnderRevision", "Under revision")}</span>
              </div>
              <p class="mt-2 text-xs text-faint">{t("wpPage.editionPlainDisabledCaption", "the same system, no equations · downloads paused for revision")}</p>
            </div>
          </div>

          <a href={L("/technology")} class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--color-brand)] transition hover:text-[color:var(--color-gold)]">
            {t("wpPage.technologyLink", "Prefer the interactive tour? See Technology →")}
          </a>
        </div>

        <div data-reveal data-reveal-delay="1">
          <div class="font-mono text-xs uppercase tracking-wider text-faint mb-4">{t("wpPage.contentsLabel", "Technical paper · contents")}</div>
          <ol class="grid gap-2 sm:grid-cols-2">
            {toc.map((s, i) => (
              <li class="flex items-center gap-3 rounded-xl border border-line-soft/40 bg-[color:var(--color-surface)] px-3.5 py-2.5 text-xs text-muted transition hover:border-line hover:bg-white/[0.02] hover:text-ink">
                <span class="font-mono text-[0.7rem] font-bold text-[color:var(--color-brand)]">{String(i + 1).padStart(2, "0")}</span>
                <span class="truncate">{s}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
</Site>
