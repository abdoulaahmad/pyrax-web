---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../../layouts/Site.astro";
import Hero from "../../components/Hero.tsx";
import LiveStats from "../../components/LiveStats.tsx";
import { isLocale, DEFAULT_LOCALE, localizePath } from "../../i18n/config";
import { useT } from "../../i18n";
import { CATEGORIES } from "../../lib/industries";
import { DOMAINS } from "../../lib/endpoints";

const { lang = DEFAULT_LOCALE } = Astro.params;
if (!isLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}`, 302);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);

const pillars = [
  { t: t("pillars.throughputT"), d: t("pillars.throughputD"), c: "#f58722", n: "500k+", nl: "TPS target" },
  { t: t("pillars.privacyT"), d: t("pillars.privacyD"), c: "#7c5cff", n: "ZK", nl: "no trusted setup" },
  { t: t("pillars.decentralT"), d: t("pillars.decentralD"), c: "#34d399", n: "3+2", nl: "streams · finality" },
  { t: t("pillars.ispT"), d: t("pillars.ispD"), c: "#60b8cc", n: "Sphinx", nl: "onion mixnet" },
];
const techStats = [
  { n: "50B", l: "Max supply (hard cap)" },
  { n: "3 VMs", l: "EVM · WASM · Cairo" },
  { n: "5 lanes", l: "TriStream seal lanes" },
  { n: "4 networks", l: "Seed · Forge · Rise · One" },
  { n: "18s", l: "L3 recursive proof" },
  { n: "100%", l: "open-core protocol" },
];
const techCards = [
  { t: "GhostDAG blockDAG", d: "A multi-parent web of blocks ordered by GhostDAG (k-cluster blue set), so honest parallel work is included, not orphaned.", href: L("/technology#consensus"), c: "#f58722" },
  { t: "TriStream mining", d: "Three streams over five seal lanes — BLAKE3 + SHA-256d (ASIC), kHeavyHash + Argon2id (GPU/CPU), and BLS proof-of-stake finality.", href: L("/technology#consensus"), c: "#60b8cc" },
  { t: "Shielded by default", d: "Every transfer hides sender, receiver, and amount with plonky2 proofs — no trusted setup, and the circuit is default-on today.", href: L("/technology#privacy"), c: "#7c5cff" },
  { t: "Multi-VM L2 + ZK-rollup L3", d: "EVM (revm), WASM (wasmtime), and Cairo with cross-VM calls; a recursive ZK-rollup folds thousands of proofs into one.", href: L("/technology#vms"), c: "#34d399" },
  { t: "Bootstrapless & ISP-resistant", d: "No company-run starter server; traffic rides an onion Sphinx mixnet so an on-path observer sees only uniform encrypted flows.", href: L("/technology#network"), c: "#4c99cc" },
  { t: "Audit-gated to mainnet", d: "Formal invariants, a documented threat model, and a single external audit of consensus + ZK + bridge before PYRAX One.", href: L("/technology#security"), c: "#fcd03d" },
];
---
<Site title="PYRAX™ Network — the private, parallel Layer-1" description={t("meta.description")} lang={lang}>
  <!-- HERO + LIVE STATS -->
  <Hero client:load lang={lang} />
  <section class="relative z-10 mx-auto -mt-4 max-w-5xl px-6 pb-16">
    <LiveStats client:load />
    <p class="mt-3 text-center text-xs text-faint">{t("hero.liveOn")} <span class="text-muted">PYRAX Seed</span> · switch networks in the navbar. Numbers are real — an offline network shows em-dashes, never fabricated figures.</p>
  </section>

  <!-- PILLARS -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="text-center">
      <h2 class="font-display text-3xl font-extrabold sm:text-4xl">{t("pillars.title")}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted">{t("pillars.subtitle")}</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <div class="group relative overflow-hidden rounded-3xl border border-line bg-[color:var(--color-surface)] p-6 transition hover:-translate-y-1 hover:border-[color:#34405a]">
          <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full blur-2xl transition group-hover:opacity-80" style={`background:radial-gradient(circle,${p.c}22,transparent 70%)`}></div>
          <div class="font-mono text-2xl font-extrabold" style={`color:${p.c}`}>{p.n}</div>
          <div class="text-[0.7rem] uppercase tracking-wider text-faint">{p.nl}</div>
          <h3 class="mt-4 text-lg font-bold">{p.t}</h3>
          <p class="mt-2 text-sm text-muted">{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TECH SHOWCASE -->
  <section class="border-y border-line bg-[color:var(--color-bg-2)]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-[color:var(--color-brand)]">Built, not planned</div>
          <h2 class="mt-2 font-display text-3xl font-extrabold sm:text-4xl">A real, tested Layer-1 — today</h2>
          <p class="mt-2 max-w-2xl text-muted">One binary, four chainspecs: a faithful simulation on real primitives, with the production consensus path wired end-to-end and gated to mainnet by external audit.</p>
        </div>
        <a href={L("/whitepaper")} class="shrink-0 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">Read the whitepaper →</a>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {techStats.map((s) => (
          <div class="rounded-2xl border border-line bg-[color:var(--color-surface)] p-4 text-center">
            <div class="font-mono text-2xl font-extrabold flame-text">{s.n}</div>
            <div class="mt-1 text-[0.68rem] text-muted">{s.l}</div>
          </div>
        ))}
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {techCards.map((c) => (
          <a href={c.href} class="group rounded-3xl border border-line bg-[color:var(--color-surface)] p-6 transition hover:-translate-y-1 hover:border-[color:#34405a]">
            <div class="h-1 w-10 rounded-full" style={`background:${c.c}`}></div>
            <h3 class="mt-4 text-lg font-bold group-hover:text-[color:var(--color-brand)]">{c.t}</h3>
            <p class="mt-2 text-sm text-muted">{c.d}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-[color:var(--color-brand)] opacity-0 transition group-hover:opacity-100">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NEURAX -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="relative overflow-hidden rounded-[2rem] border border-line bg-[radial-gradient(140%_120%_at_100%_0%,rgba(124,92,255,0.12),transparent_55%),radial-gradient(120%_120%_at_0%_100%,rgba(245,134,34,0.1),transparent_55%)] p-8 sm:p-12">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.2em] text-[color:var(--color-brand)]">NEURAX</div>
          <h2 class="mt-2 font-display text-3xl font-extrabold sm:text-4xl">Idle GPUs become a verifiable compute market</h2>
          <p class="mt-3 max-w-xl text-muted">The same hardware that mines Stream B runs paid AI and compute jobs, settled on-chain and priced at a fixed 8 PYRX per compute unit. A four-rung verification ladder — redundancy, fraud proofs, interactive dispute, and TEE attestation — replaces blind trust with cryptographic proof.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={L("/technology#neurax")} class="rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">How NEURAX works</a>
            <a href={L("/industries/ai-data-compute")} class="rounded-full px-4 py-2 text-sm font-semibold text-[color:var(--color-brand)]">AI & compute industries →</a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {[
            { n: "8 PYRX", l: "per compute unit (1 RTX-4090-hour)" },
            { n: "4B", l: "PYRX AI-compute pool" },
            { n: "4-rung", l: "verification ladder" },
            { n: "RTX 3060", l: "local-first baseline GPU" },
          ].map((x) => (
            <div class="rounded-2xl border border-line bg-[rgba(9,11,18,0.6)] p-5">
              <div class="font-mono text-xl font-extrabold text-[color:#7c5cff]">{x.n}</div>
              <div class="mt-1 text-xs text-muted">{x.l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES TEASER -->
  <section class="border-y border-line bg-[color:var(--color-bg-2)]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="text-center">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-[color:var(--color-brand)]">Industries</div>
        <h2 class="mt-2 font-display text-3xl font-extrabold sm:text-4xl">{t("cta.industriesTitle")}</h2>
        <p class="mx-auto mt-3 max-w-2xl text-muted">{t("cta.industriesBody")}</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {CATEGORIES.map((c) => (
          <a href={L(`/industries/${c.slug}`)} class="group rounded-2xl border border-line bg-[color:var(--color-surface)] p-5 transition hover:-translate-y-1 hover:border-[color:#34405a]">
            <div class="h-8 w-8 rounded-xl" style={`background:linear-gradient(135deg,${c.color},${c.color}55)`}></div>
            <div class="mt-3 text-sm font-bold group-hover:text-[color:var(--color-brand)]">{c.name}</div>
            <div class="mt-1 text-[0.7rem] text-faint">{c.businesses.length} business types</div>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href={L("/industries")} class="inline-flex rounded-full bg-gradient-to-r from-[color:var(--color-gold)] via-[color:var(--color-brand)] to-[color:var(--color-ember)] px-6 py-3 text-sm font-bold text-[#1a0f06] transition hover:brightness-110">{t("nav.exploreIndustries")} →</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="mx-auto max-w-7xl px-6 py-20">
    <div class="grid gap-4 lg:grid-cols-2">
      <a href={L("/developers")} class="group relative overflow-hidden rounded-[2rem] border border-line bg-[color:var(--color-surface)] p-8 transition hover:border-[color:#34405a] sm:p-10">
        <h3 class="font-display text-2xl font-extrabold">{t("cta.buildTitle")}</h3>
        <p class="mt-2 max-w-md text-muted">{t("cta.buildBody")}</p>
        <span class="mt-6 inline-flex text-sm font-bold text-[color:var(--color-brand)]">{t("cta.build")} →</span>
      </a>
      <a href={L("/pitch")} class="group relative overflow-hidden rounded-[2rem] border border-line bg-[radial-gradient(120%_120%_at_100%_0%,rgba(245,134,34,0.12),transparent_60%)] p-8 transition hover:border-[color:#34405a] sm:p-10">
        <h3 class="font-display text-2xl font-extrabold">For investors</h3>
        <p class="mt-2 max-w-md text-muted">An interactive, animated deck — the vision, the technology, the tokenomics, and the ask.</p>
        <span class="mt-6 inline-flex text-sm font-bold text-[color:var(--color-brand)]">Open the pitch deck →</span>
      </a>
    </div>
  </section>
</Site>
