---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../../../layouts/Site.astro";
import { isLocale, DEFAULT_LOCALE, localizePath } from "../../../i18n/config";
import { useT } from "../../../i18n";
import { categoryBySlug } from "../../../lib/industries";

const { lang = DEFAULT_LOCALE, category = "" } = Astro.params;
if (!isLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/industries`, 302);
const cat = categoryBySlug(category);
if (!cat) return Astro.redirect(`/${lang}/industries`, 302);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);
---
<Site title={`${cat.name} — PYRAX Blockchain Solutions | PYRAX™ Network`} description={cat.blurb} lang={lang}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full blur-3xl" style={`background:radial-gradient(circle,${cat.color}22,transparent 62%)`}></div>
    <div class="mx-auto max-w-7xl px-6 py-16">
      <a href={L("/industries")} class="text-sm text-muted hover:text-ink">{t("industriesUi.allIndustries", "← All industries")}</a>
      <div class="mt-5 flex items-center gap-4">
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl" style={`background:linear-gradient(135deg,${cat.color},${cat.color}44)`}></span>
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.2em]" style={`color:${cat.color}`}>{cat.tagline}</div>
          <h1 class="mt-1 font-display text-3xl font-extrabold sm:text-5xl">{cat.name}</h1>
        </div>
      </div>
      <p class="mt-5 max-w-3xl text-lg text-muted">{cat.blurb}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cat.businesses.map((b, i) => (
        <a href={L(`/industries/${cat.slug}/${b.slug}`)} class="group flex flex-col rounded-3xl border border-line bg-[color:var(--color-surface)] p-6 transition hover:-translate-y-1 hover:border-[color:#34405a]">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs text-faint">{String(i + 1).padStart(2, "0")}</span>
            <span class="h-2 w-2 rounded-full" style={`background:${cat.color}`}></span>
          </div>
          <h3 class="mt-3 text-lg font-bold group-hover:text-[color:var(--color-brand)]">{b.name}</h3>
          <p class="mt-2 flex-1 text-sm text-muted">{b.hook}</p>
          <span class="mt-4 inline-flex text-sm font-semibold text-[color:var(--color-brand)]">{t("industriesUi.cardCta", "Financials · integrations · dApps →")}</span>
        </a>
      ))}
    </div>
  </section>
</Site>
