---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../../../../layouts/Site.astro";
import { isLocale, DEFAULT_LOCALE, localizePath } from "../../../../i18n/config";
import { useT } from "../../../../i18n";
import { categoryBySlug, businessBySlug } from "../../../../lib/industries";
import { contentFor } from "../../../../lib/industry-content";
import { DOMAINS } from "../../../../lib/endpoints";

const { lang = DEFAULT_LOCALE, category = "", business = "" } = Astro.params;
if (!isLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/industries`, 302);
const cat = categoryBySlug(category);
const biz = businessBySlug(category, business);
if (!cat || !biz) return Astro.redirect(`/${lang}/industries`, 302);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);
const c = contentFor(category, business);
const idx = cat.businesses.findIndex((b) => b.slug === business);
const next = cat.businesses[(idx + 1) % cat.businesses.length];
const prev = cat.businesses[(idx - 1 + cat.businesses.length) % cat.businesses.length];
---
<Site title={`${biz.name} on PYRAX — Blockchain Solutions | PYRAX™ Network`} description={c?.overview ?? biz.hook} lang={lang}>
  <!-- header -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full blur-3xl" style={`background:radial-gradient(circle,${cat.color}22,transparent 62%)`}></div>
    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
        <a href={L("/industries")} class="hover:text-ink">{t("industriesUi.breadcrumbIndustries", "Industries")}</a><span class="text-faint">/</span>
        <a href={L(`/industries/${cat.slug}`)} class="hover:text-ink" style={`color:${cat.color}`}>{cat.name}</a><span class="text-faint">/</span>
        <span class="text-ink">{biz.name}</span>
      </div>
      <h1 class="mt-4 font-display text-4xl font-extrabold sm:text-5xl">{biz.name} <span class="text-faint">{t("industriesUi.onPyrax", "on PYRAX")}</span></h1>
      <p class="mt-4 max-w-3xl text-lg text-muted">{c?.overview ?? biz.hook}</p>
      {c && (
        <div class="mt-6 flex flex-wrap gap-3">
          <div class="rounded-2xl border border-line bg-[color:var(--color-surface)] px-4 py-3"><div class="text-[0.62rem] uppercase tracking-wider text-faint">{t("industriesUi.marketSizeLabel", "Market size")}</div><div class="mt-0.5 font-mono text-lg font-extrabold flame-text">{c.marketSize}</div></div>
          <div class="rounded-2xl border border-line bg-[color:var(--color-surface)] px-4 py-3"><div class="text-[0.62rem] uppercase tracking-wider text-faint">{t("industriesUi.projectionLabel", "Projection")}</div><div class="mt-0.5 font-mono text-lg font-extrabold text-[color:var(--color-positive)]">{c.projection}</div></div>
        </div>
      )}
    </div>
  </section>

  {c ? (
    <div class="mx-auto max-w-5xl px-6 py-14">
      <!-- market -->
      <section>
        <h2 class="font-display text-2xl font-extrabold">{t("industriesUi.theMarket", "The market")}</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {c.stats.map((s) => (
            <div class="rounded-2xl border border-line bg-[color:var(--color-surface)] p-5">
              <div class="font-mono text-xl font-extrabold text-ink">{s.value}</div>
              <div class="mt-1 text-xs text-muted">{s.label}</div>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-faint">{t("industriesUi.sourcePrefix", "Source:")} {c.source}. {t("industriesUi.figuresNote", "Figures are indicative and provided for context.")}</p>
      </section>

      <!-- pain points -->
      <section class="mt-12">
        <h2 class="font-display text-2xl font-extrabold">{t("industriesUi.whatsBroken", "What's broken today")}</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {c.painPoints.map((p) => (
            <div class="flex gap-3 rounded-2xl border border-line bg-[color:var(--color-surface)] p-4">
              <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[rgba(251,111,115,0.12)] text-[color:var(--color-negative)]"><svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></span>
              <span class="text-sm text-muted">{p}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- PYRAX solutions -->
      <section class="mt-12">
        <h2 class="font-display text-2xl font-extrabold">{t("industriesUi.howPyraxTransforms", "How PYRAX transforms it")}</h2>
        <p class="mt-1 text-muted">{t("industriesUi.solutionsSubtitle", "Concrete network elements mapped to this business.")}</p>
        <div class="mt-5 grid gap-3 md:grid-cols-2">
          {c.solutions.map((s) => (
            <div class="rounded-2xl border border-line bg-[color:var(--color-surface)] p-5">
              <div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full" style={`background:${cat.color}`}></span><h3 class="text-base font-bold">{s.feature}</h3></div>
              <p class="mt-2 text-sm text-muted">{s.how}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- dApp ideas / buildathon -->
      <section class="mt-12">
        <div class="flex items-end justify-between">
          <div><h2 class="font-display text-2xl font-extrabold">{t("industriesUi.buildathonTitle", "Buildathon: dApp ideas")}</h2><p class="mt-1 text-muted">{t("industriesUi.buildathonSubtitlePrefix", "Ship-ready concepts for ")}{biz.name.toLowerCase()}{t("industriesUi.buildathonSubtitleSuffix", " on PYRAX.")}</p></div>
          <a href={DOMAINS.explorer} class="hidden shrink-0 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink transition hover:border-[color:#34405a] sm:inline">{t("industriesUi.startBuilding", "Start building →")}</a>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {c.dapps.map((d, i) => (
            <div class="group rounded-2xl border border-line bg-[color:var(--color-surface)] p-5 transition hover:border-[color:#34405a]">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-base font-bold group-hover:text-[color:var(--color-brand)]">{d.name}</h3>
                <span class="font-mono text-xs text-faint">{String(i + 1).padStart(2, "0")}</span>
              </div>
              <p class="mt-2 text-sm text-muted">{d.desc}</p>
              {d.tags && <div class="mt-3 flex flex-wrap gap-1.5">{d.tags.map((tg) => <span class="rounded-full border border-line px-2 py-0.5 text-[0.62rem] text-faint">{tg}</span>)}</div>}
            </div>
          ))}
        </div>
      </section>
    </div>
  ) : (
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <div class="rounded-3xl border border-line bg-[color:var(--color-surface)] p-10">
        <h2 class="font-display text-2xl font-extrabold">{t("industriesUi.briefInProgress", "Detailed brief in progress")}</h2>
        <p class="mt-3 text-muted">{biz.hook}{t("industriesUi.briefBodyPrefix", " The full market analysis, PYRAX integration map, and buildathon dApp ideas for ")}<span class="text-ink">{biz.name}</span>{t("industriesUi.briefBodySuffix", " are being finalized.")}</p>
        <a href={L(`/industries/${cat.slug}`)} class="mt-6 inline-flex rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">{t("industriesUi.backToPrefix", "Back to ")}{cat.name}{t("industriesUi.backToSuffix", " →")}</a>
      </div>
    </div>
  )}

  <!-- prev/next -->
  <div class="mx-auto max-w-5xl px-6 pb-16">
    <div class="flex items-center justify-between gap-3 border-t border-line pt-6">
      <a href={L(`/industries/${cat.slug}/${prev.slug}`)} class="rounded-full border border-line px-4 py-2 text-sm text-muted transition hover:text-ink">← {prev.name}</a>
      <a href={L(`/industries/${cat.slug}`)} class="text-sm text-faint hover:text-ink">{t("industriesUi.allCategoryPrefix", "All ")}{cat.name}</a>
      <a href={L(`/industries/${cat.slug}/${next.slug}`)} class="rounded-full border border-line px-4 py-2 text-sm text-muted transition hover:text-ink">{next.name} →</a>
    </div>
  </div>
</Site>
