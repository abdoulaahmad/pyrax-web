---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../../layouts/Site.astro";
import { isLocale, DEFAULT_LOCALE, localizePath } from "../../i18n/config";
import { useT } from "../../i18n";
import { TOKEN, ALLOCATIONS, GENESIS, EMISSIONS, FEES, STAKING, GOVERNANCE, COMPUTE, fmt } from "../../lib/tokenomics";
import { DOMAINS } from "../../lib/endpoints";

const { lang = DEFAULT_LOCALE } = Astro.params;
if (!isLocale(lang)) return Astro.redirect(`/${DEFAULT_LOCALE}/token`, 302);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);

// Build the SVG donut segments from the allocation percentages.
const R = 52, C = 2 * Math.PI * R;
let acc = 0;
const segs = ALLOCATIONS.map((a) => {
  const len = (a.pct / 100) * C;
  const seg = { color: a.color, dash: `${len} ${C - len}`, offset: -acc * C / 100, ...a };
  acc += a.pct;
  return seg;
});

const heroStats = [
  { n: "50B", l: t("tokenPage.heroStat1", "Max supply · hard cap") },
  { n: "$0.0025", l: t("tokenPage.heroStat2", "Genesis price") },
  { n: "75%", l: t("tokenPage.heroStat3", "Premine · 25% mined") },
  { n: "PYRX", l: t("tokenPage.heroStat4", "Ticker · 18 decimals") },
];

// Translate shared tokenomics DATA strings (from tokenomics.ts) via the tokData namespace.
const FEE_KEY: Record<string, string> = { "Burned": "feeBurned", "PYRAX treasury": "feePyraxTreasury", "DAO": "feeDao", "Block producer": "feeBlockProducer" };
const feeLabel = (l: string) => t(`tokData.${FEE_KEY[l] ?? l}`, l);
const emKeys = ["emInitialSubsidy", "emHalving", "emCap", "emToCap", "emSplit"];
const emVals = [EMISSIONS.initialSubsidy, EMISSIONS.halving, EMISSIONS.cap, EMISSIONS.toCap, EMISSIONS.split];
---
<Site title="PYRX Tokenomics — PYRAX™ Network" description="The complete PYRX tokenomics: a 50B hard cap enforced in consensus, a 75% premine + 25% mined over ~26 years, a consensus-frozen EIP-1559 fee split, staking, governance, and the NEURAX compute economy." lang={lang}>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-backdrop absolute inset-0 opacity-40"></div>
    <div class="pointer-events-none absolute -left-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-[radial-gradient(circle,rgba(245,134,34,0.18),transparent_60%)] blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-20">
      <div class="text-xs font-semibold uppercase tracking-[0.2em] text-[color:var(--color-brand)]">{t("tokenPage.eyebrow", "Tokenomics")}</div>
      <h1 class="mt-3 max-w-4xl font-display text-4xl font-extrabold sm:text-6xl">{t("tokenPage.economyPre", "The ")}<span class="flame-text">PYRX</span>{t("tokenPage.economyPost", " economy")}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">{t("tokenPage.heroSubtitle", "A fixed 50-billion supply enforced in consensus, a transparent premine, mining that runs for a quarter-century, and a fee split no one — not even a governance vote — can ever change.")}</p>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {heroStats.map((s, i) => (
          <div data-reveal data-reveal-delay={String((i % 5) + 1)} class="rounded-2xl border border-line bg-[color:var(--color-surface)] p-5">
            <div class="font-mono text-2xl font-extrabold flame-text">{s.n}</div>
            <div class="mt-1 text-xs text-muted">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DISTRIBUTION -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:items-center">
      <div data-reveal data-reveal="scale" class="mx-auto">
        <svg viewBox="0 0 140 140" class="h-64 w-64 -rotate-90">
          <circle cx="70" cy="70" r={R} fill="none" stroke="var(--color-line-soft)" stroke-width="15" />
          {segs.map((s) => (
            <circle cx="70" cy="70" r={R} fill="none" stroke={s.color} stroke-width="15"
              stroke-dasharray={s.dash} stroke-dashoffset={s.offset} stroke-linecap="butt" />
          ))}
        </svg>
        <div class="-mt-40 mb-40 text-center">
          <div class="font-mono text-3xl font-extrabold flame-text">50B</div>
          <div class="text-xs text-faint">{t("tokenPage.hardCap", "PYRX hard cap")}</div>
        </div>
      </div>
      <div>
        <h2 class="font-display text-3xl font-extrabold">{t("tokenPage.distributionTitle", "Genesis distribution")}</h2>
        <p class="mt-2 max-w-2xl text-muted">{t("tokenPage.distributionBody", "Every pool is seeded into a reserved, credit-only system account at genesis. The 12.5B mining share is the only supply not present at launch — it is minted to block producers over ~26 years.")}</p>
        <div class="mt-6 space-y-2">
          {ALLOCATIONS.map((a, i) => (
            <div data-reveal data-reveal-delay={String((i % 5) + 1)} class="flex items-center gap-4 rounded-2xl border border-line bg-[color:var(--color-surface)] p-4">
              <span class="h-3 w-3 shrink-0 rounded-full" style={`background:${a.color}`}></span>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <span class="font-semibold text-ink">{t(`tokData.alloc${i}Label`, a.label)}</span>
                  <span class="font-mono text-sm text-muted">{fmt(a.amount)} · {a.pct}%</span>
                </div>
                <div class="mt-1 text-xs text-faint">{t(`tokData.alloc${i}Note`, a.note)}</div>
                <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-[color:var(--color-line-soft)]"><div class="h-full rounded-full" style={`width:${a.pct}%;background:${a.color}`}></div></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {[
        { t: t("tokenPage.card1Title", "The genesis event"), d: t("tokData.genesisSold", GENESIS.sold), e: t("tokData.genesisBonus", GENESIS.bonus) },
        { t: t("tokenPage.card2Title", "Participants receive"), d: t("tokData.genesisReceived", GENESIS.received), e: t("tokenPage.card2Explain", "The bonus is framed as network access / compute credits — never an investment return.") },
        { t: t("tokenPage.card3Title", "Initial circulating"), d: TOKEN.initialCirculating + t("tokenPage.card3Suffix", " of 50B"), e: t("tokenPage.card3Explain", "Team vests on a 12-month cliff + 36-month linear; ecosystem 40% at TGE.") },
      ].map((x, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)} class="rounded-3xl border border-line bg-[color:var(--color-bg-2)] p-6">
          <div class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-brand)]">{x.t}</div>
          <div class="mt-2 font-semibold text-ink">{x.d}</div>
          <p class="mt-2 text-sm text-muted">{x.e}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- EMISSIONS + FEES -->
  <section class="border-y border-line bg-[color:var(--color-bg-2)]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-10 lg:grid-cols-2">
        <div data-reveal>
          <h2 class="font-display text-2xl font-extrabold">{t("tokenPage.emissionsTitle", "Emissions")}</h2>
          <p class="mt-2 text-muted">{t("tokenPage.emissionsIntro", "Bitcoin-style, but four-year halvings and a hard mining cap. After the cap, block producers are paid entirely by fees.")}</p>
          <dl class="mt-6 space-y-3">
            {[
              [t("tokenPage.emInitialSubsidy", "Initial subsidy"), t(`tokData.${emKeys[0]}`, emVals[0])],
              [t("tokenPage.emHalving", "Halving"), t(`tokData.${emKeys[1]}`, emVals[1])],
              [t("tokenPage.emCap", "Cap"), t(`tokData.${emKeys[2]}`, emVals[2])],
              [t("tokenPage.emSchedule", "Schedule"), t(`tokData.${emKeys[3]}`, emVals[3])],
              [t("tokenPage.emSplit", "Per-stream split"), t(`tokData.${emKeys[4]}`, emVals[4])],
            ].map(([k, v]) => (
              <div class="flex flex-col gap-1 border-b border-line-soft pb-3 sm:flex-row sm:items-center sm:justify-between">
                <dt class="text-sm text-faint">{k}</dt><dd class="font-mono text-sm text-ink sm:text-right">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div data-reveal data-reveal-delay="2">
          <h2 class="font-display text-2xl font-extrabold">{t("tokenPage.feesTitle", "Fees")} <span class="text-sm font-normal text-faint">{t("tokenPage.feesSub", "· EIP-1559, consensus-frozen")}</span></h2>
          <p class="mt-2 text-muted">{t("tokenPage.feesIntro", "The split is frozen in consensus — no governance vote can ever touch it.")}</p>
          <div class="mt-6 space-y-6">
            <div>
              <div class="mb-2 text-sm font-semibold text-ink">{t("tokenPage.baseFee", "Base fee")}</div>
              <div class="flex h-9 overflow-hidden rounded-xl">
                {FEES.baseFee.map((f) => (<div class="grid place-items-center text-[0.7rem] font-bold text-[#160a04]" style={`width:${f.pct}%;background:${f.color}`}>{f.pct}%</div>))}
              </div>
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">{FEES.baseFee.map((f) => (<span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style={`background:${f.color}`}></span>{feeLabel(f.label)}</span>))}</div>
            </div>
            <div>
              <div class="mb-2 text-sm font-semibold text-ink">{t("tokenPage.priorityTip", "Priority tip")}</div>
              <div class="flex h-9 overflow-hidden rounded-xl">
                {FEES.tip.map((f) => (<div class="grid place-items-center text-[0.7rem] font-bold text-[#160a04]" style={`width:${f.pct}%;background:${f.color}`}>{f.pct}%</div>))}
              </div>
              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">{FEES.tip.map((f) => (<span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style={`background:${f.color}`}></span>{feeLabel(f.label)}</span>))}</div>
            </div>
            <div class="rounded-2xl border border-line bg-[color:var(--color-surface)] p-4 text-sm text-muted">{t("tokData.feeShielded", FEES.shielded)}. <span class="text-faint">{t("tokData.feeGasLimit", FEES.gasLimit)}.</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STAKING / GOV / COMPUTE -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-4 lg:grid-cols-3">
      <div data-reveal class="rounded-3xl border border-line bg-[color:var(--color-surface)] p-6">
        <h3 class="font-display text-xl font-extrabold">{t("tokenPage.stakingTitle", "Staking")}</h3>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.minStake", "Min stake")}</dt><dd class="font-mono text-ink">{t("tokData.stakeMinStake", STAKING.minStake)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.unbonding", "Unbonding")}</dt><dd class="font-mono text-ink">{t("tokData.stakeUnbonding", STAKING.unbonding)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.slashing", "Slashing")}</dt><dd class="font-mono text-ink text-right">{t("tokData.stakeSlash", STAKING.slash)}</dd></div>
        </dl>
        <p class="mt-4 text-xs text-muted">{t("tokenPage.validatorsEarnPre", "Validators earn ")}{t("tokData.stakeEarns", STAKING.earns)}{t("tokenPage.validatorsEarnPost", ".")}</p>
      </div>
      <div data-reveal data-reveal-delay="1" class="rounded-3xl border border-line bg-[color:var(--color-surface)] p-6">
        <h3 class="font-display text-xl font-extrabold">{t("tokenPage.governanceTitle", "Governance")}</h3>
        <p class="mt-3 text-xs text-faint">{t("tokenPage.governableIntro", "Exactly three parameters are governable:")}</p>
        <ul class="mt-2 space-y-1 text-sm text-muted">{GOVERNANCE.governable.map((g, gi) => (<li class="flex gap-2"><span class="text-[color:var(--color-brand)]">·</span>{t(`tokData.govParam${gi}`, g)}</li>))}</ul>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.quorum", "Quorum")}</dt><dd class="font-mono text-ink">{t("tokData.govQuorum", GOVERNANCE.quorum)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.pass", "Pass")}</dt><dd class="font-mono text-ink">{t("tokData.govPass", GOVERNANCE.pass)}</dd></div>
        </dl>
        <p class="mt-4 text-xs text-muted"><span class="text-[color:var(--color-negative)]">{t("tokenPage.frozenForever", "Frozen forever:")}</span> {t("tokData.govFrozen", GOVERNANCE.frozen)}.</p>
      </div>
      <div data-reveal data-reveal-delay="2" class="rounded-3xl border border-line bg-[radial-gradient(120%_120%_at_100%_0%,rgba(124,92,255,0.14),transparent_60%)] p-6">
        <h3 class="font-display text-xl font-extrabold">{t("tokenPage.computeTitle", "NEURAX compute")}</h3>
        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.price", "Price")}</dt><dd class="font-mono text-ink">{t("tokData.computePerCu", COMPUTE.perCu)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.poolBudget", "Pool budget")}</dt><dd class="font-mono text-ink text-right">{t("tokData.computePoolBudget", COMPUTE.poolBudget)}</dd></div>
          <div class="flex justify-between gap-3"><dt class="text-faint">{t("tokenPage.jobCap", "Job cap")}</dt><dd class="font-mono text-ink text-right">{t("tokData.computeDrawdownCap", COMPUTE.drawdownCap)}</dd></div>
        </dl>
        <p class="mt-4 text-xs text-muted">{t("tokData.computeCu", COMPUTE.cu)}. {t("tokData.computeTransition", COMPUTE.transition)}.</p>
        <a href={L("/technology#neurax")} class="mt-4 inline-flex text-sm font-semibold text-[color:#7c5cff]">{t("tokenPage.neuraxLink", "How NEURAX works →")}</a>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-center">
      <a href={L("/whitepaper")} class="rounded-full bg-gradient-to-r from-[color:var(--color-gold)] via-[color:var(--color-brand)] to-[color:var(--color-ember)] px-6 py-3 text-sm font-bold text-[#1a0f06] transition hover:brightness-110">{t("tokenPage.ctaWhitepaper", "Read the full whitepaper →")}</a>
      <a href={DOMAINS.explorer} class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink transition hover:border-[color:#34405a]">{t("tokenPage.ctaExplorer", "Open the explorer")}</a>
    </div>
  </section>
</Site>
