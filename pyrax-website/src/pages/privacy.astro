---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../layouts/Site.astro";
import { DEFAULT_LOCALE, resolveLocale } from "../i18n/config";

const lang = resolveLocale(Astro.url, Astro.cookies);
const UPDATED = "2 July 2026";
const CONTACT = "privacy@pyrax.org";

// Each section: a heading + an ordered list of blocks. A string block is a paragraph; a
// { list } block is a bulleted list. Kept as data so the markup stays clean + consistent.
type Block = string | { list: string[] };
const sections: { id: string; h: string; blocks: Block[] }[] = [
  {
    id: "intro", h: "1. Introduction",
    blocks: [
      "This Privacy Policy explains how the PYRAX Network project (“PYRAX”, “we”, “us”) collects, uses, and protects information when you visit our websites and use our services — including this marketing site, the block explorer, the node hub and peer directory, the closed-alpha tester portal, the desktop node apps, the command-line node, and the wallet (together, the “Services”).",
      "PYRAX is a decentralized, privacy-focused Layer-1 blockchain project. Much of what the project does happens on a public, peer-to-peer network that no single party controls. This policy focuses on the data we, as the operators of the Services, actually handle — and is clear about the on-chain data we do not (and cannot) control.",
    ],
  },
  {
    id: "collect", h: "2. Information we collect",
    blocks: [
      "We aim to collect as little as possible. Depending on how you use the Services, this may include:",
      { list: [
        "Information you provide: an email address (for closed-alpha access, magic-link sign-in, or alert subscriptions), a chosen display name or handle, a payout wallet address, and any content you submit (bug reports, chat messages, support requests).",
        "Technical data: IP address, browser and device type, pages visited, referring page, and timestamps — collected to operate, secure, and improve the Services and to prevent abuse.",
        "Cookies and local storage: small identifiers used for sign-in sessions, security, and (only with your consent) analytics and preferences. See section 5.",
        "Node/telemetry data (optional): if you run a node and opt in, aggregate liveness and version information used to show network health and award tester rewards. Node telemetry can be disabled.",
      ] },
      "We do not intentionally collect special-category (sensitive) personal data, and we ask that you do not submit it through the Services.",
    ],
  },
  {
    id: "keys", h: "3. Wallets, keys, and what we never see",
    blocks: [
      "The PYRAX wallet and node apps are self-custodial. Your private keys, seed phrase, and passwords are generated and stored on your own device — they are never transmitted to us, and we cannot access, recover, or reset them. Never share your seed phrase with anyone, including anyone claiming to be from PYRAX.",
      "A public wallet address you choose to share (for example, a payout address for tester rewards) is treated like any other information you provide.",
    ],
  },
  {
    id: "onchain", h: "4. On-chain data is public and permanent",
    blocks: [
      "Transactions and other data recorded on a blockchain are, by design, public, immutable, and replicated across independent nodes. When data is written to a PYRAX network, we cannot edit or delete it, and neither can you. Shielded (private) transactions hide certain details on-chain, but the existence of on-chain records is inherent to how blockchains work.",
      "Please consider this before transacting. Any information you place on-chain — or link to your address off-chain — may be visible to others indefinitely.",
    ],
  },
  {
    id: "use", h: "5. How we use information",
    blocks: [
      "We use the information above to:",
      { list: [
        "provide, operate, secure, and improve the Services;",
        "authenticate you (magic-link / one-time codes) and maintain your session;",
        "send transactional messages you request (sign-in codes, invites, release and status alerts);",
        "run the closed-alpha program, including tester rewards accounting;",
        "detect, prevent, and investigate fraud, abuse, and security incidents;",
        "understand aggregate usage and improve performance (only with analytics consent); and",
        "comply with applicable law.",
      ] },
      "We do not sell your personal information, and we do not use it for third-party advertising.",
    ],
  },
  {
    id: "cookies", h: "6. Cookies and local storage",
    blocks: [
      "We use strictly necessary cookies/local storage for sign-in sessions and security — these are always on because the Services cannot function without them. Analytics and preference cookies are optional and set only if you consent via the cookie banner, which you can change at any time.",
    ],
  },
  {
    id: "sharing", h: "7. Service providers and sharing",
    blocks: [
      "We share data only with providers that help us run the Services, under agreements that limit their use of it — for example, cloud hosting and networking, a transactional email provider for the messages you request, and abuse-prevention and content-delivery services. We may also disclose information if required by law or to protect the rights, safety, and security of users and the Services.",
    ],
  },
  {
    id: "retention", h: "8. Data retention",
    blocks: [
      "We keep personal data only as long as needed for the purposes above or as required by law, then delete or anonymize it. Operational logs and abuse-prevention data are kept for a limited period. On-chain data cannot be deleted (see section 4).",
    ],
  },
  {
    id: "rights", h: "9. Your rights",
    blocks: [
      "Depending on where you live, you may have rights to access, correct, delete, port, or restrict the processing of your personal data, to object to certain processing, and to withdraw consent. To exercise these rights, contact us at " + CONTACT + ". We will respond as required by applicable law. Note that we cannot alter on-chain records, and some data must be retained for legal or security reasons.",
    ],
  },
  {
    id: "transfers", h: "10. International transfers & security",
    blocks: [
      "The Services are operated using infrastructure that may process data in countries other than yours. We use appropriate safeguards for such transfers. We apply reasonable technical and organizational measures to protect information, but no method of transmission or storage is completely secure.",
    ],
  },
  {
    id: "children", h: "11. Children",
    blocks: [
      "The Services are not directed to children under the age of majority in their jurisdiction (and at minimum under 18), and we do not knowingly collect their personal data. If you believe a child has provided us data, contact us and we will delete it.",
    ],
  },
  {
    id: "changes", h: "12. Changes to this policy",
    blocks: [
      "We may update this policy as the project and the law evolve. We will change the “last updated” date above and, for material changes, provide additional notice where appropriate. Continued use of the Services after an update means you accept the revised policy.",
    ],
  },
  {
    id: "contact", h: "13. Contact",
    blocks: [
      "Questions about this policy or your data? Email " + CONTACT + ".",
    ],
  },
];
---
<Site title="Privacy Policy — PYRAX™ Network" description="How the PYRAX Network project collects, uses, and protects your information across our websites, apps, and services." lang={lang}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="grid-backdrop absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-16">
      <div class="eyebrow eyebrow-rule text-[color:var(--color-brand)]">Legal</div>
      <h1 class="mt-3 font-display text-4xl font-extrabold uppercase sm:text-5xl">Privacy Policy</h1>
      <p class="mt-4 text-sm text-faint">Last updated: {UPDATED}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-14">
    <p class="text-muted">This policy is provided for transparency. It is a general description of our practices and is not legal advice; specific rights and obligations depend on your jurisdiction.</p>
    <div class="mt-10 space-y-10">
      {sections.map((s) => (
        <div id={s.id} class="scroll-mt-24">
          <h2 class="font-display text-2xl font-extrabold text-ink">{s.h}</h2>
          <div class="mt-3 space-y-3">
            {s.blocks.map((b) => (
              typeof b === "string"
                ? <p class="text-muted leading-relaxed">{b}</p>
                : <ul class="list-disc space-y-2 pl-6 text-muted">{b.list.map((li) => (<li class="leading-relaxed">{li}</li>))}</ul>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="mt-14 border-t border-line-soft pt-6 text-sm text-faint">
      See also our <a href="/terms" class="text-[color:var(--color-brand)] hover:underline">Terms &amp; Conditions</a>.
    </div>
  </section>
</Site>
