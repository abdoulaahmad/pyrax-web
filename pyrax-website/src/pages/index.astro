---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Site from "../layouts/Site.astro";
import Hero from "../components/Hero.tsx";
import { DEFAULT_LOCALE, localizePath, resolveLocale } from "../i18n/config";
import { useT } from "../i18n";
import { CATEGORIES } from "../lib/industries";
import { DOMAINS } from "../lib/endpoints";
import { headline } from "../lib/headline";

const lang = resolveLocale(Astro.url, Astro.cookies);
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);

const invariants = [
  { t: t("pillars.throughputT"), d: t("pillars.throughputD"), c: "#f68a24", n: "500k+", nl: "TPS TARGET" },
  { t: t("pillars.privacyT"), d: t("pillars.privacyD"), c: "#5cbace", n: "ZK", nl: "NO TRUSTED SETUP" },
  { t: t("pillars.decentralT"), d: t("pillars.decentralD"), c: "#3ddc84", n: "3+2", nl: "STREAMS · FINALITY" },
  { t: t("pillars.ispT"), d: t("pillars.ispD"), c: "#5cbace", n: "Sphinx", nl: "ONION MIXNET" },
];
const tickerItems = [
  { k: "500k+", v: t("homeExtra.tickerTps", "TPS target") },
  { k: "50B", v: t("homeExtra.techStatMaxSupply", "Max supply (hard cap)") },
  { k: "3 VMs", v: t("homeExtra.techStatVms", "EVM · WASM · Cairo") },
  { k: "5 lanes", v: t("homeExtra.techStatSealLanes", "TriStream seal lanes") },
  { k: "18s", v: t("homeExtra.techStatRecursiveProof", "L3 recursive proof") },
  { k: "100%", v: t("homeExtra.techStatOpenCore", "open-core protocol") },
  { k: "4 networks", v: t("homeExtra.techStatNetworks", "Seed · Forge · Rise · One") },
];
const techStats = [
  { n: "50B", l: t("homeExtra.techStatMaxSupply", "Max supply (hard cap)") },
  { n: "3 VMs", l: t("homeExtra.techStatVms", "EVM · WASM · Cairo") },
  { n: "5 lanes", l: t("homeExtra.techStatSealLanes", "TriStream seal lanes") },
  { n: "4 networks", l: t("homeExtra.techStatNetworks", "Seed · Forge · Rise · One") },
  { n: "18s", l: t("homeExtra.techStatRecursiveProof", "L3 recursive proof") },
  { n: "100%", l: t("homeExtra.techStatOpenCore", "open-core protocol") },
];
const techCards = [
  { tag: "CONSENSUS", t: t("homeExtra.techCard1T", "GhostDAG"), d: t("homeExtra.techCard1D", "A multi-parent web of blocks ordered by GhostDAG (k-cluster blue set), so honest parallel work is included, not orphaned."), href: L("/technology#consensus"), c: "#f68a24" },
  { tag: "MINING", t: t("homeExtra.techCard2T", "TriStream mining"), d: t("homeExtra.techCard2D", "Three streams over five seal lanes — BLAKE3 + SHA-256d (ASIC), kHeavyHash + Argon2id (GPU/CPU), and BLS proof-of-stake finality."), href: L("/technology#consensus"), c: "#5cbace" },
  { tag: "PRIVACY", t: t("homeExtra.techCard3T", "Shielded by default"), d: t("homeExtra.techCard3D", "Every transfer hides sender, receiver, and amount with plonky2 proofs — no trusted setup, and the circuit is default-on today."), href: L("/technology#privacy"), c: "#fed23c" },
  { tag: "EXECUTION", t: t("homeExtra.techCard4T", "Multi-VM L2 + ZK-rollup L3"), d: t("homeExtra.techCard4D", "EVM (revm), WASM (wasmtime), and Cairo with cross-VM calls; a recursive ZK-rollup folds thousands of proofs into one."), href: L("/technology#vms"), c: "#3ddc84" },
  { tag: "NETWORK", t: t("homeExtra.techCard5T", "Bootstrapless & ISP-resistant"), d: t("homeExtra.techCard5D", "No company-run starter server; traffic rides an onion Sphinx mixnet so an on-path observer sees only uniform encrypted flows."), href: L("/technology#network"), c: "#3983c3" },
  { tag: "SECURITY", t: t("homeExtra.techCard6T", "Audit-gated to mainnet"), d: t("homeExtra.techCard6D", "Formal invariants, a documented threat model, and a single external audit of consensus + ZK + bridge before PYRAX One."), href: L("/technology#security"), c: "#fed23c" },
];

// Curated per-category photography for the industries teaser (same order as CATEGORIES).
const industryPhotoIds = [
  "photo-1611974789855-9c2a0a7236a3", "photo-1494412574643-ff11b0a5c1c3", "photo-1576091160399-112ba8d25d1d",
  "photo-1542751371-adc38448a05e", "photo-1480714378408-67cf0d13bc1b", "photo-1509391366360-2e959784a276",
  "photo-1555848962-6e79363ec58f", "photo-1441986300917-64674bd600d8", "photo-1460661419201-fd4cecdf8a8b",
  "photo-1518770660439-4636190af475",
];
const industryPhotos = CATEGORIES.map((c, i) => ({ ...c, img: `https://images.unsplash.com/${industryPhotoIds[i]}?q=80&w=640&auto=format&fit=crop` }));
---
<Site title="PYRAX™ Network — the private, high-throughput Layer-1" description={t("meta.description")} lang={lang}>
  <!-- HERO (embeds the live widget) -->
  <Hero client:load lang={lang} />

  <!-- STAT TICKER -->
  <div class="overflow-hidden border-b border-line bg-[color:var(--color-bg-2)]">
    <div class="flex w-max ticker-track py-4">
      {[...tickerItems, ...tickerItems].map((it) => (
        <span class="inline-flex items-center gap-3 whitespace-nowrap border-r border-line-soft px-8 font-mono text-[0.78rem] text-muted">
          <b class="font-semibold text-[color:var(--color-gold)]">{it.k}</b>{it.v}
        </span>
      ))}
    </div>
  </div>

  <!-- FOUR INVARIANTS -->
  <section class="relative overflow-hidden border-b border-line px-5 py-24 sm:px-10">
    <div class="ghost-index absolute right-6 top-8 text-[9rem] sm:text-[12rem]">01</div>
    <div class="relative mx-auto max-w-6xl">
      <div class="mb-14 max-w-2xl">
        <div class="eyebrow text-[color:var(--color-brand)]">01 / Invariants</div>
        <h2 class="mt-4 text-3xl uppercase sm:text-5xl">
          {lang === "en" ? (<>Four invariants <span class="outline-text">not features</span></>) : headline(t("pillars.title"))}
        </h2>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-muted">{t("pillars.subtitle")}</p>
      </div>
      <div class="flex flex-col border-t border-line">
        {invariants.map((p, i) => (
          <div class="group grid grid-cols-2 items-center gap-4 border-b border-line px-2 py-8 transition hover:bg-[rgba(255,255,255,0.02)] sm:grid-cols-[80px_180px_220px_1fr] sm:gap-8">
            <span class="hidden font-display text-4xl font-bold text-transparent sm:block" style="-webkit-text-stroke: 1px rgba(255,255,255,0.22)">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <div class="font-display text-xl font-semibold" style={`color:${p.c}`}>{p.n}</div>
              <div class="mt-1.5 font-mono text-[0.62rem] tracking-[0.12em] text-faint">{p.nl}</div>
            </div>
            <div class="font-display text-base font-medium uppercase tracking-tight">{p.t}</div>
            <p class="text-sm leading-relaxed text-muted">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILT NOT PLANNED -->
  <section class="border-b border-line bg-[color:var(--color-bg-2)] px-5 py-24 sm:px-10">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 grid gap-8 lg:grid-cols-2 lg:items-end">
        <div>
          <div class="eyebrow text-[color:var(--color-bolt-bright)]">02 / Built, not planned</div>
          <h2 class="mt-4 text-2xl uppercase sm:text-4xl">A real tested<br /><span class="outline-text">Layer-1 — today</span></h2>
        </div>
        <p class="text-sm leading-relaxed text-muted">{t("homeExtra.techParagraph", "One binary, four chainspecs: a faithful simulation on real primitives, with the production consensus path wired end-to-end and gated to mainnet by external audit.")} <a href={L("/whitepaper")} class="font-semibold text-[color:var(--color-brand)]">{t("homeExtra.readWhitepaper", "Read the whitepaper →")}</a></p>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {techStats.map((s) => (
          <div class="relative rounded-2xl border border-line bg-[color:var(--color-surface)] p-5">
            <span class="absolute -top-px left-3.5 h-px w-6 bg-[color:var(--color-brand)]"></span>
            <div class="font-display text-xl font-semibold leading-none">{s.n}</div>
            <div class="mt-2.5 font-mono text-[0.62rem] leading-tight text-faint">{s.l}</div>
          </div>
        ))}
      </div>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {techCards.map((c) => (
          <a href={c.href} class="group relative overflow-hidden rounded-2xl border border-line bg-[color:var(--color-surface)] p-6 transition hover:border-[color:var(--color-line-soft)] hover:bg-[color:var(--color-elevated)]">
            <div class="mb-4 flex items-center justify-between">
              <span class="font-mono text-[0.65rem] tracking-[0.14em]" style={`color:${c.c}`}>{c.tag}</span>
              <span class="text-sm text-faint transition group-hover:translate-x-0.5 group-hover:text-ink">→</span>
            </div>
            <h3 class="text-base font-medium normal-case">{c.t}</h3>
            <p class="mt-2 text-[0.82rem] leading-relaxed text-muted">{c.d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PYRAX COMPUTE — GPU MARKETPLACE -->
  <section class="relative overflow-hidden border-b border-line bg-[linear-gradient(150deg,#0c2744_0%,#123a63_55%,#0e2c4d_100%)]">
    <div class="ghost-index absolute -top-10 right-0 text-[16rem] sm:text-[22rem]" style="-webkit-text-stroke: 1px rgba(255,255,255,0.09)">GPU</div>
    <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=1600&auto=format&fit=crop" alt="" class="absolute inset-0 h-full w-full object-cover opacity-[0.14] saturate-[0.3]" />
    <div class="relative mx-auto max-w-6xl px-5 py-24 sm:px-10">
      <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <div class="eyebrow" style="color:var(--color-bolt-bright)">{t("homeExtra.computeEyebrow", "03 / PYRAX Compute · GPU Marketplace")}</div>
          <h2 class="mt-4 text-2xl uppercase sm:text-4xl">Verifiable GPU compute <br /><span class="outline-text" style="-webkit-text-stroke: 1.2px rgba(254,210,60,0.9)">Decentralized</span> on-chain</h2>
          <p class="mt-6 max-w-lg text-[0.95rem] leading-relaxed text-white/75">{t("homeExtra.computeParagraph", "PYRAX Compute turns global GPU hardware into an open, verifiable marketplace. Run AI inference, fine-tuning, and rendering settled on-chain through cryptographic execution receipts — replacing centralized cloud monopolies with permissionless, escrow-backed compute.")}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={L("/industries/ai-data-compute")} class="rounded-full bg-white px-6 py-3.5 text-sm font-bold text-[#0c2744]">{t("homeExtra.computeHowItWorks", "Explore PYRAX Compute")}</a>
            <a href={L("/technology#consensus")} class="rounded-full border border-white/35 px-6 py-3.5 text-sm font-semibold text-white transition hover:border-[color:var(--color-gold)] hover:text-[color:var(--color-gold)]">{t("homeExtra.computeIndustries", "Mining & compute architecture →")}</a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3.5">
          {[
            { n: "8 PYRX", l: t("homeExtra.computeTile1L", "per compute unit (1 RTX-4090-hour)") },
            { n: "Escrow", l: t("homeExtra.computeTile2L", "trustless on-chain job settlement") },
            { n: "4-rung", l: t("homeExtra.computeTile3L", "verification & dispute ladder") },
            { n: "Global", l: t("homeExtra.computeTile4L", "distributed provider network") },
          ].map((x) => (
            <div class="rounded-2xl border border-white/[0.14] bg-[rgba(5,6,9,0.5)] p-6 backdrop-blur-sm">
              <div class="font-display text-2xl font-semibold leading-none text-[color:var(--color-gold)]">{x.n}</div>
              <div class="mt-2.5 text-[0.78rem] leading-relaxed text-white/65">{x.l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES TEASER (photography) -->
  <section class="border-b border-line px-5 py-24 sm:px-10">
    <div class="mx-auto max-w-6xl">
      <div class="mb-11 flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="eyebrow text-[color:var(--color-brand)]">04 / Industries</div>
          <h2 class="mt-4 text-2xl uppercase sm:text-4xl">PYRAX for<br /><span class="outline-text">your industry</span></h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-muted">{t("cta.industriesBody")}</p>
      </div>
      <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-5">
        {industryPhotos.map((c) => (
          <a href={L(`/industries/${c.slug}`)} class="group relative block h-[170px] overflow-hidden rounded-2xl border border-line transition hover:border-[color:var(--color-brand)]">
            <img src={c.img} alt={c.name} class="absolute inset-0 h-full w-full object-cover saturate-[0.35] brightness-[0.66] contrast-[1.05] transition duration-300 group-hover:scale-105" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,6,9,0.15),rgba(5,6,9,0.86)_82%)]"></div>
            <div class="absolute inset-x-4 bottom-3.5">
              <div class="text-[0.82rem] font-medium leading-tight text-ink">{c.name}</div>
              <div class="mt-1.5 font-mono text-[0.62rem] text-[color:var(--color-gold)]">{c.businesses.length} {t("homeExtra.businessTypes", "business types")} →</div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-9 text-center">
        <a href={L("/industries")} class="inline-block rounded-full border border-line-soft px-7 py-3.5 text-sm font-semibold text-ink transition hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)]">{t("nav.exploreIndustries")} →</a>
      </div>
    </div>
  </section>

  <!-- DUAL CTA -->
  <section class="px-5 py-20 sm:px-10">
    <div class="mx-auto grid max-w-6xl gap-4 lg:grid-cols-2">
      <a href={L("/developers")} class="group relative overflow-hidden rounded-[1.25rem] border border-[rgba(246,138,36,0.3)] bg-[linear-gradient(140deg,rgba(218,84,39,0.14),var(--color-surface)_60%)] p-10 transition hover:border-[color:var(--color-brand)]">
        <div class="eyebrow text-[color:var(--color-brand)]">{t("nav.developers")}</div>
        <h3 class="mt-4 text-xl normal-case">{t("cta.buildTitle")}</h3>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">{t("cta.buildBody")}</p>
        <span class="mt-6 inline-flex text-sm font-bold text-[color:var(--color-brand)]">{t("cta.build")} →</span>
      </a>
      <a href={L("/pitch")} class="group relative overflow-hidden rounded-[1.25rem] border border-[rgba(57,131,195,0.32)] bg-[linear-gradient(140deg,rgba(25,99,169,0.16),var(--color-surface)_60%)] p-10 transition hover:border-[color:var(--color-bolt)]">
        <div class="eyebrow text-[color:var(--color-bolt-bright)]">{t("navPanels.devFeatureEyebrow", "Investors")}</div>
        <h3 class="mt-4 text-xl normal-case">{t("homeExtra.investorsTitle", "For investors")}</h3>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">{t("homeExtra.investorsBody", "An interactive, animated deck — the vision, the technology, the tokenomics, and the ask.")}</p>
        <span class="mt-6 inline-flex text-sm font-bold text-[color:var(--color-bolt-bright)]">{t("homeExtra.openPitchDeck", "Open the pitch deck →")}</span>
      </a>
    </div>
  </section>
</Site>
