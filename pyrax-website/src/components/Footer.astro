---
// SPDX-License-Identifier: LicenseRef-Proprietary
import { DOMAINS, SOCIAL } from "../lib/endpoints";
import { CATEGORIES } from "../lib/industries";
import { localizePath } from "../i18n/config";
import { useT } from "../i18n";
const { lang = "en" } = Astro.props;
const t = useT(lang);
const L = (p: string) => localizePath(lang, p);
const year = 2026;
const cols = [
  { title: t("footer.product"), links: [
    { label: t("nav.explorer"), href: DOMAINS.explorer }, { label: t("nav.nodes"), href: DOMAINS.nodes },
    { label: t("nav.devnet"), href: DOMAINS.devnet }, { label: t("nav.network"), href: L("/network") },
  ] },
  { title: t("footer.developers"), links: [
    { label: t("nav.docs"), href: L("/developers") }, { label: t("nav.whitepaper"), href: L("/whitepaper") },
    { label: "GitHub", href: SOCIAL.github }, { label: t("nav.token"), href: L("/token") },
  ] },
  { title: t("nav.industries"), links: CATEGORIES.slice(0, 5).map((c) => ({ label: c.name, href: L(`/industries/${c.slug}`) })).concat([{ label: t("nav.viewAll"), href: L("/industries") }]) },
  { title: t("nav.company"), links: [
    { label: t("nav.company"), href: L("/company") }, { label: t("nav.pitch"), href: L("/pitch") },
    { label: t("navPanels.footerRoadmap", "Roadmap"), href: L("/network#roadmap") }, { label: t("navPanels.footerSecurity", "Security"), href: L("/technology#security") },
  ] },
];
const socials = [
  { k: "x", href: SOCIAL.x, d: "M4 4l7.5 9.5L4.5 20H7l5.2-5.6L16.5 20H20l-7.8-9.9L19.5 4H17l-4.7 5.1L8.5 4z" },
  { k: "discord", href: SOCIAL.discord, d: "M8 12a1 1 0 100 .01M16 12a1 1 0 100 .01M6 7c4-1.5 8-1.5 12 0 1.5 4 1.5 8 0 12-1.5.8-3 1.2-4 1l-1-1.5c1-.3 2-.7 2.5-1M6 7c-1.5 4-1.5 8 0 12 1.5.8 3 1.2 4 1l1-1.5c-1-.3-2-.7-2.5-1" },
  { k: "telegram", href: SOCIAL.telegram, d: "M21 4 3 11l5 2 2 6 3-4 4 3 4-14z" },
  { k: "github", href: SOCIAL.github, d: "M9 19c-4 1.3-4-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.8-.3 4.5-1.4 4.5-5a4 4 0 00-1-2.7 3.7 3.7 0 00-.1-2.7s-.9-.3-3 1a13 13 0 00-6 0c-2.1-1.3-3-1-3-1a3.7 3.7 0 00-.1 2.7A4 4 0 004 10c0 3.6 1.7 4.7 4.5 5-.6.6-.6 1.2-.5 2V21" },
  { k: "youtube", href: SOCIAL.youtube, d: "M3 8a3 3 0 013-3h12a3 3 0 013 3v8a3 3 0 01-3 3H6a3 3 0 01-3-3zM10 9l5 3-5 3z" },
];
---
<footer class="border-t border-line bg-[color:var(--color-bg-2)]">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
      <div>
        <a href={L("/")} class="flex items-center" aria-label="PYRAX Network — home"><img src="/brand/logo-horizontal.svg" alt="PYRAX™ Network" class="nodrag h-9 w-auto" /></a>
        <p class="mt-3 max-w-xs text-sm text-muted">{t("footer.tagline")}</p>
        <div class="mt-4 flex gap-2">
          {socials.map((s) => (<a href={s.href} target="_blank" rel="noopener" aria-label={s.k} class="grid h-9 w-9 place-items-center rounded-full border border-line-soft text-muted transition hover:border-[color:var(--color-brand)] hover:text-ink"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={s.d}/></svg></a>))}
        </div>
      </div>
      {cols.map((col) => (
        <div>
          <div class="eyebrow text-faint">{col.title}</div>
          <ul class="mt-3 space-y-2">{col.links.map((l) => (<li><a href={l.href} class="text-sm text-muted transition hover:text-ink">{l.label}</a></li>))}</ul>
        </div>
      ))}
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-line-soft pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
      <div>© {year} PYRAX™ Network. {t("footer.rights")}</div>
      <div class="flex items-center gap-4">
        <a href={L("/privacy")} class="transition hover:text-ink">{t("footer.privacy", "Privacy")}</a>
        <a href={L("/terms")} class="transition hover:text-ink">{t("footer.terms", "Terms")}</a>
      </div>
      <div class="max-w-xl sm:text-right">{t("footer.openCore")}</div>
    </div>
  </div>
</footer>
