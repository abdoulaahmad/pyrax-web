{
  "name": "pyrax-team-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PYRAX Team Portal — gated, super-granular role-based internal hub (team.pyraxchain.com).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host --port 4321",
    "build": "astro build",
    "preview": "astro preview --host --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "redteam": "vitest run --config redteam/vitest.redteam.config.ts",
    "redteam:watch": "vitest --config redteam/vitest.redteam.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/react": "^4.2.1",
    "@types/pg": "^8.20.0",
    "astro": "^5.4.2",
    "framer-motion": "^11.18.2",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
