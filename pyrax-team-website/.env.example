# SPDX-License-Identifier: LicenseRef-Proprietary
#
# PYRAX Team Portal — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env (see .gitignore). Placeholders below are safe and non-functional.
#
# Legend:
#   [REQUIRED]  must be set in production — the app fails closed / can't function without it.
#   [optional]  has a safe default or degrades gracefully (e.g. email send is skipped, GIF picker off).
# ============================================================================================

# --- Runtime ---------------------------------------------------------------------------------
# [REQUIRED in prod] "production" enables CSP/HSTS and the fail-closed secret guards (SESSION_SECRET
# + DEVNET_CHAT_SECRET refuse to boot if unset or left at their dev defaults). Leave unset locally.
NODE_ENV=production

# Public origin of the portal (used for absolute links in emails, etc.). [optional]
PUBLIC_URL=https://team.pyraxchain.com

# [optional] Number of TRUSTED appending proxies in front of the app, so per-IP rate limits (OTP
# sign-in) can resolve the real caller from X-Forwarded-For (counted from the RIGHT — never the
# spoofable leftmost hop). 0/unset = ignore XFF and key on the socket peer (the safe default; only
# set this when the exact proxy topology is known). Behind Caddy only = 1; Cloudflare -> Caddy = 2.
# "1"/"true"/"on" all mean a single trusted proxy.
TRUST_PROXY=0

# --- Secrets (fail-closed in production) -----------------------------------------------------
# [REQUIRED in prod] Keys the HMAC for OTP codes + session ids. Generate 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must NOT be the dev default; the app throws on boot in production if missing/default.
SESSION_SECRET=change-me-to-a-long-random-string

# [REQUIRED in prod] HMAC key for the short-lived chat token shared with the standalone chat WS
# server. Must match the value the chat server + the devnet portal use. Must NOT be the dev default
# ("dev-chat-secret-change-me"); the app throws on boot in production if missing/default.
DEVNET_CHAT_SECRET=change-me-to-the-shared-chat-secret

# --- Databases (DigitalOcean Managed Postgres; all on one cluster) ---------------------------
# [REQUIRED] The team portal's own database (`team_pyrax`). Either DATABASE_URL_TEAM_PYRAX or the
# generic DATABASE_URL must be set; DATABASE_URL takes precedence if both are present.
DATABASE_URL_TEAM_PYRAX=postgres://user:password@db-host:25060/team_pyrax?sslmode=require
# DATABASE_URL=postgres://user:password@db-host:25060/team_pyrax?sslmode=require

# [optional] The shared Devnet Tester database (`devnet_tester`). If unset, it is derived from the
# team URL by swapping the database name. Required only for the Devnet Management surfaces.
DATABASE_URL_DEVNET=postgres://user:password@db-host:25060/devnet_tester?sslmode=require

# [optional] The public Nodes site database (`pyrax_nodes`). If unset, it is derived from the team
# URL by swapping the database name. Required only for the Network & App Management surfaces.
DATABASE_URL_NODES=postgres://user:password@db-host:25060/pyrax_nodes?sslmode=require

# --- Superuser -------------------------------------------------------------------------------
# [optional] The immutable founder/superuser account, seeded + force-active on boot.
# Defaults to shawn.wilson@pyraxchain.com.
SUPERUSER_EMAIL=shawn.wilson@pyraxchain.com

# --- Email (Brevo transactional API) ---------------------------------------------------------
# [REQUIRED in prod] Without this, OTP + invite emails are silently skipped (sign-in would break).
BREVO_API_KEY=xkeysib-your-brevo-api-key
# [optional] Sender identity (must be a verified Brevo sender).
BREVO_SENDER=no-reply@pyraxchain.com
BREVO_SENDER_NAME=PYRAX Team
# [optional] If set, the OTP is delivered via this Brevo stored template ({{params.otp}});
# otherwise the built-in inline HTML is used. 0/unset = use inline HTML.
BREVO_OTP_TEMPLATE_ID=0
# [optional] Stored template id for the devnet closed-alpha invite. 0/unset = inline HTML.
BREVO_DEVNET_INVITE_TEMPLATE_ID=0

# --- Devnet chat + GIPHY ---------------------------------------------------------------------
# [optional] WebSocket URL of the shared chat server. Defaults to ws://localhost:8788.
CHAT_WS_URL=wss://chat.pyraxchain.com
# [optional] Enables the in-chat GIF picker. Unset = GIF picker disabled (no error).
GIPHY_API_KEY=your-giphy-api-key

# --- Cross-site integration (Nodes site) -----------------------------------------------------
# [REQUIRED for broadcasts] Shared bearer secret to call the nodes site's admin broadcast endpoint.
# Without it, the "Broadcast notifications" action returns a configuration error.
NODES_ADMIN_SECRET=change-me-to-the-shared-nodes-admin-secret
# [optional] Base URL of the public nodes site. Defaults to https://nodes.pyraxchain.com.
NODES_SITE_URL=https://nodes.pyraxchain.com

# --- Cross-site integration (Devnet portal) --------------------------------------------------
# [optional] Base URL of the devnet tester portal, used to build invite links.
# Defaults to https://devnet.pyraxchain.com.
DEVNET_PUBLIC_URL=https://devnet.pyraxchain.com

# --- NEURAX Sentinel (SRE) -------------------------------------------------------------------
# The team portal is the ONLY admin front-door for NEURAX Sentinel: the SRE-gated console here
# proxies to the Sentinel backend with this shared bearer. status.pyraxchain.com is public-only.
# [REQUIRED for the Sentinel console] Shared bearer secret the Sentinel backend accepts.
# Without it, the Sentinel console reports "not configured".
SENTINEL_ADMIN_SECRET=change-me-to-the-shared-sentinel-admin-secret
# [optional] Base URL of the Sentinel backend. Defaults to https://status.pyraxchain.com.
SENTINEL_BACKEND_URL=https://status.pyraxchain.com
