{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@pyrax/shared": ["../pyrax-shared/src/index.ts"],
      "@pyrax/shared/*": ["../pyrax-shared/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../pyrax-shared/src"]
}
