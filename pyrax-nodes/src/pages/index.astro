---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.tsx";
const features = [
  { icon: "globe", title: "Live 3D network map", body: "Watch real nodes light up across the planet, coloured by network, in an interactive globe.", href: "/map", cta: "Open the map" },
  { icon: "users", title: "Peer directory", body: "Browse every online peer on a network — dial address, location, and uptime, updated in real time.", href: "/peers", cta: "Browse peers" },
  { icon: "download", title: "Run your own node", body: "Download the Inferno app or the CLI and join the network in minutes — no port-forwarding required.", href: "/downloads", cta: "Get the node" },
];
---
<Base title="Nodes" current="/">
  <Hero client:load />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="grid gap-5 md:grid-cols-3">
      {features.map((f) => (
        <a href={f.href} class="card card-hover group block p-6">
          <div class="mb-4 grid h-11 w-11 place-items-center rounded-xl border border-line bg-[rgba(245,134,34,0.08)] text-[color:var(--color-brand)]">
            <span set:html={`<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>${f.icon === "globe" ? "<circle cx='12' cy='12' r='9'/><path d='M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18'/>" : f.icon === "users" ? "<circle cx='9' cy='8' r='3.2'/><path d='M3.5 20a5.5 5.5 0 0 1 11 0'/><path d='M16 5.5a3.2 3.2 0 0 1 0 6.3'/><path d='M17.5 14.5A5.5 5.5 0 0 1 21 20'/>" : "<path d='M12 4v11m0 0 4-4m-4 4-4-4'/><path d='M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2'/>"}</svg>`} />
          </div>
          <h3 class="text-lg font-bold">{f.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{f.body}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[color:var(--color-brand)]">{f.cta}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform group-hover:translate-x-0.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>
