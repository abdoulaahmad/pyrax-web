---
// SPDX-License-Identifier: LicenseRef-Proprietary
import Base from "../layouts/Base.astro";
const steps = [
  { n: 1, title: "Get the node", body: "Download the Inferno app (Windows / macOS / Linux) or install the CLI on a server." },
  { n: 2, title: "Pick a network", body: "Choose the network to join. The app discovers peers automatically through the decentralized directory." },
  { n: 3, title: "Start your node", body: "Hit start. Your node dials out to peers — no port-forwarding or firewall changes needed." },
  { n: 4, title: "Earn & participate", body: "Keep your node online to help secure the network, relay blocks, and earn rewards where eligible." },
];
const reasons = [
  { icon: "shield", title: "Secure the network", body: "Every node validates and relays — more nodes means a stronger, more decentralized PYRAX." },
  { icon: "bolt", title: "No port-forwarding", body: "Nodes connect outbound and traverse NAT automatically. Run one from home or a laptop." },
  { icon: "trophy", title: "Earn PYRX", body: "Operators and miners earn rewards for uptime and contribution where the program is live." },
];
const tiers = [
  { tier: "Operator", cpu: "2 cores", ram: "4 GB", disk: "40 GB SSD", note: "Validate + relay" },
  { tier: "Miner", cpu: "4 cores", ram: "8 GB", disk: "80 GB SSD", note: "+ GPU/CPU mining" },
  { tier: "RPC", cpu: "4 cores", ram: "16 GB", disk: "200 GB SSD", note: "Public read RPC" },
];
const svg = (p: string) => `<svg viewBox='0 0 24 24' width='22' height='22' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>${p}</svg>`;
const icons: Record<string, string> = {
  shield: "<path d='M12 3 5 6v5c0 4.5 3 7.8 7 9 4-1.2 7-4.5 7-9V6l-7-3Z'/><path d='m9.5 12 1.8 1.8L15 10'/>",
  bolt: "<path d='M13 2 4 14h7l-1 8 9-12h-7l1-8Z'/>",
  trophy: "<path d='M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0V4Z'/><path d='M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3'/>",
};
---
<Base title="Run a Node" current="/run" description="How to run a PYRAX node — download, pick a network, start, and earn. No port-forwarding required.">
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="max-w-2xl">
      <h1 class="text-3xl font-extrabold sm:text-5xl">Run a PYRAX node</h1>
      <p class="mt-4 text-lg text-muted">Join the network from anywhere in minutes. Help secure PYRAX, relay blocks, and earn rewards — all without touching your router.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/downloads" class="btn btn-primary px-6 py-3 text-base">Get the node app</a>
        <a href="/peers" class="btn btn-ghost px-6 py-3 text-base">See who's online</a>
      </div>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {reasons.map((r) => (
        <div class="card p-6">
          <div class="mb-3 grid h-11 w-11 place-items-center rounded-xl border border-line bg-[rgba(245,134,34,0.08)] text-[color:var(--color-brand)]" set:html={svg(icons[r.icon])} />
          <h3 class="text-lg font-bold">{r.title}</h3>
          <p class="mt-1.5 text-sm text-muted">{r.body}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-16 text-2xl font-bold">Four steps to live</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div class="card p-5">
          <div class="flame-text text-3xl font-extrabold">{s.n}</div>
          <h3 class="mt-1 font-bold">{s.title}</h3>
          <p class="mt-1 text-sm text-muted">{s.body}</p>
        </div>
      ))}
    </div>

    <h2 id="rpc" class="mt-16 text-2xl font-bold">Hardware</h2>
    <div class="mt-5 overflow-hidden rounded-2xl border border-line">
      <table class="w-full text-sm">
        <thead><tr class="border-b border-line text-left text-xs uppercase tracking-wider text-faint">
          <th class="px-4 py-3 font-semibold">Role</th><th class="px-4 py-3 font-semibold">CPU</th><th class="px-4 py-3 font-semibold">RAM</th><th class="px-4 py-3 font-semibold">Disk</th><th class="px-4 py-3 font-semibold">Notes</th>
        </tr></thead>
        <tbody>
          {tiers.map((t) => (
            <tr class="border-b border-line-soft last:border-0">
              <td class="px-4 py-3 font-semibold text-ink">{t.tier}</td><td class="px-4 py-3 text-muted">{t.cpu}</td><td class="px-4 py-3 text-muted">{t.ram}</td><td class="px-4 py-3 text-muted">{t.disk}</td><td class="px-4 py-3 text-muted">{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
