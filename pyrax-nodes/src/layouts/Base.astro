---
// SPDX-License-Identifier: LicenseRef-Proprietary
import "../styles/global.css";
import Topbar from "../components/Topbar.tsx";
import Footer from "../components/Footer.tsx";
import ClosedGate from "../components/ClosedGate.tsx";
import CookieConsent from "../components/CookieConsent.tsx";
import { getSiteSettings } from "../server/settings";
// Brand title rule: every page title starts with "PYRAX™". (Standard for all PYRAX sites.)
interface Props { title?: string; description?: string; current?: string }
const {
  title = "Nodes",
  description = "Download a PYRAX node, explore the live peer directory + 3D network map, and connect to a decentralized blockchain built to endure.",
  current = "/",
} = Astro.props;
const fullTitle = /^PYRAX/.test(title) ? title : `PYRAX™ · ${title}`;
// The team can "close" the public site from the portal — visitors then see a coming-soon + notify
// signup. The peer-directory ingest + APIs are unaffected (the network keeps running).
const settings = await getSiteSettings();
const closed = !settings.open;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#06070b" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {closed ? (
      <>
        <div class="flame-bar fixed inset-x-0 top-0 z-40 h-[3px]"></div>
        <ClosedGate client:load message={settings.closedMessage} />
      </>
    ) : (
      <>
        <Topbar client:load current={current} />
        <main class="min-h-[60vh] pt-16">
          <slot />
        </main>
        <Footer client:visible />
      </>
    )}
    <CookieConsent client:idle />
  </body>
</html>
