# SPDX-License-Identifier: LicenseRef-Proprietary
#
# PYRAX Nodes (nodes.pyraxchain.com) — environment template. Copy to `.env` for local dev, or set these
# in the deployment environment (pyrax-infra docker-compose / GHCR). NEVER commit real secrets — `.env`
# and `.env.*` are gitignored (only this `.env.example` is tracked). Placeholders below are SAFE dummies.

# ─── Runtime ────────────────────────────────────────────────────────────────────────────────────────
# Set by the Dockerfile in production; included here so local runs match. NODE_ENV=production turns ON
# the fail-closed ingest guard (announce/deregister return 503 unless a real PYRAX_DIRECTORY_SECRET is
# set — see below).
NODE_ENV=development
HOST=0.0.0.0
PORT=4323

# ─── Peer-directory ingest (HMAC) ────────────────────────────────────────────────────────────────────
# Shared secret nodes use to sign /api/announce + /api/deregister (HMAC-SHA256). REQUIRED in production:
# if this is unset/left at the published dev placeholder, ingest is refused (503) under NODE_ENV=production
# so nobody can forge announces and poison the peer map. Generate: `openssl rand -hex 32`.
PYRAX_DIRECTORY_SECRET=replace-with-a-long-random-secret

# Trust a reverse proxy in front (e.g. Caddy) for the client IP. When set ("1" or "true"), /api/announce
# reads the PROXY-ATTESTED hop from `X-Forwarded-For` — the entry the trusted proxy APPENDED, counted
# from the RIGHT (never the client-controlled leftmost hop, and never the request-body `ip`). LEAVE UNSET
# unless a trusted proxy is terminating connections — otherwise clients could spoof their location on the
# map. Default = use the real socket peer address.
# TRUSTED_PROXY=1
# Number of trusted proxies that APPEND to X-Forwarded-For, counted from the right (Caddy alone = 1;
# Cloudflare in front of Caddy = 2). Only read when TRUSTED_PROXY is set. Default = 1.
# TRUSTED_PROXY_HOPS=1

# Networks accepted by the ingest (comma-separated labels). Announces for any other label are rejected.
PYRAX_ENABLED_NETWORKS=seed,forge,rise,one

# How long (ms) a peer is considered "live" after its last announce (presence TTL).
PYRAX_DIRECTORY_TTL_MS=30000

# ─── Geo-IP enrichment (server-side, for the 3D globe) ───────────────────────────────────────────────
# Override the geo provider base URL (HTTPS recommended); a lookup appends `/<ip>?fields=...`.
# Default = https://ip-api.com/json
# PYRAX_GEO_URL=https://ip-api.com/json
# Set to "1" to disable geo-IP lookups entirely (no outbound geo calls; globe shows only located nodes).
# PYRAX_GEO_DISABLE=0

# ─── Admin broadcast (server-to-server, called by the team portal) ───────────────────────────────────
# Bearer secret authorizing POST /api/admin/broadcast (email + push fan-out). Must match the team portal.
# Generate: `openssl rand -hex 32`. If unset, broadcast is refused.
NODES_ADMIN_SECRET=replace-with-a-long-random-admin-secret

# ─── Web Push (self-hosted VAPID) ────────────────────────────────────────────────────────────────────
# VAPID keypair for self-hosted browser push. Generate with: `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:no-reply@pyraxchain.com

# ─── Brevo (notify list — email) ─────────────────────────────────────────────────────────────────────
# Transactional/contact API for the "PYRAX Nodes — Notify" list. If BREVO_API_KEY/LIST_ID are unset,
# email signup/broadcast degrade gracefully (push can still work).
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_NODES_LIST_ID=0
BREVO_NODES_NOTIFY_TEMPLATE_ID=0
BREVO_SENDER=no-reply@pyraxchain.com

# ─── Database (DigitalOcean Managed Postgres, pyrax_nodes DB) ────────────────────────────────────────
# Connection string for the shared cluster's pyrax_nodes database (site settings + push subscriptions).
# If unset, the site still runs against safe in-memory defaults (DB-backed features no-op). Any `?sslmode`
# is stripped at runtime (the pool always uses ssl.rejectUnauthorized=false for the managed cluster CA).
# Fallbacks if DATABASE_URL_NODES is unset: DATABASE_URL or DATABASE_URL_TEAM_PYRAX (the /team_pyrax DB
# name is rewritten to /pyrax_nodes).
DATABASE_URL_NODES=postgres://USER:PASSWORD@HOST:25060/pyrax_nodes
